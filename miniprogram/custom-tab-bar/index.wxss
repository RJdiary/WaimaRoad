.tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 100; display: flex; height: calc(112rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; background: #F0E0C7; }
.tabbar__item { display: flex; flex: 1; align-items: center; justify-content: center; }
