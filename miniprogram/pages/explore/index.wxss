
.explore { position: relative; } .explore__header { position: relative; height: 440rpx; overflow: hidden; transition: height 240ms cubic-bezier(.2,.8,.2,1); } .explore__header--collapsed { height: 200rpx; } .explore__collage { position: absolute; top: 30rpx; right: -24rpx; width: 620rpx; height: 380rpx; opacity: .95; background: repeating-linear-gradient(90deg,#E7D3B4 0 52rpx,#DCC3A2 52rpx 92rpx,#CBB18C 92rpx 116rpx); mask-image: linear-gradient(90deg,transparent 0,#000 12%,#000 88%,transparent 100%); transition: transform 240ms cubic-bezier(.2,.8,.2,1),opacity 240ms; } .explore__header--collapsed .explore__collage { transform: translateY(-120rpx) scale(.8); opacity: .7; } .explore__timeline { position:absolute; top:46%; width:100%; height:2rpx; background:#C0392B; } .explore__photo { position:absolute; width:96rpx; height:72rpx; background:linear-gradient(135deg,#333,#999); opacity:.7; } .explore__photo--1{left:140rpx;top:72rpx}.explore__photo--2{left:310rpx;top:160rpx}.explore__photo--3{left:450rpx;top:70rpx}.explore__photo--4{left:400rpx;top:265rpx}.explore__calligraphy { position:absolute; top:96rpx; left:48rpx; display:flex; flex-direction:row; gap:8rpx; writing-mode:vertical-rl; font-size:calc(56rpx * var(--fs)); line-height:1.15; letter-spacing:2rpx; transition:transform 240ms; transform-origin:top left; } .explore__header--collapsed .explore__calligraphy { transform:scale(.8); }
.explore__map-wrap { position:relative; height:540rpx; margin:-40rpx 48rpx 0; overflow:hidden; border:4rpx solid #F5D9A8; border-radius:24rpx; background:var(--tan); } .explore__map-wrap--fullscreen { position:fixed; inset:0; z-index:50; height:auto; margin:0; border:0; border-radius:0; } .explore__map-loading { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:var(--bg-warm); color:var(--ink-3); font-size:calc(24rpx * var(--fs)); } .explore__map-tools { position:absolute; top:50%; right:20rpx; display:flex; flex-direction:column; gap:16rpx; transform:translateY(-50%); } .explore__map-tool { display:flex; width:64rpx; height:64rpx; align-items:center; justify-content:center; border:1rpx solid #F5D9A8; border-radius:50%; background:rgba(255,255,255,.85); } .explore__exit { position:absolute; top:24rpx; right:24rpx; padding:16rpx 20rpx; border-radius:44rpx; background:var(--white); font-size:calc(24rpx * var(--fs)); }
.explore__search { position:absolute; top:464rpx; right:72rpx; display:flex; width:72rpx; height:72rpx; align-items:center; justify-content:center; border:1rpx solid var(--amber); border-radius:50%; background:rgba(255,255,255,.85); z-index:3; } .explore__search--fixed { position:fixed; top:calc(var(--status, 0px) + 8px); top:8px; right:24rpx; } .explore__search-ring { width:25rpx; height:25rpx; border:4rpx solid var(--amber); border-radius:50%; position:relative; } .explore__search-ring::after { content:''; position:absolute; width:14rpx; height:4rpx; right:-11rpx; bottom:-6rpx; transform:rotate(45deg); background:var(--amber); }
.explore__location-tip { display:flex; height:64rpx; margin:24rpx 48rpx 0; padding:0 20rpx; align-items:center; justify-content:space-between; border-radius:8rpx; background:var(--apricot); color:#4A3B33; font-size:calc(24rpx * var(--fs)); }.explore__entries { display:grid; grid-template-columns:repeat(2,1fr); gap:24rpx; margin:40rpx 48rpx; }.explore__entry { position:relative; height:220rpx; overflow:hidden; border-radius:20rpx; color:var(--white); }.explore__entry swiper { height:220rpx; }.explore__entry-bg { height:100%; }.card-a{background:linear-gradient(135deg,#D98C75,#B65A44)}.card-b{background:linear-gradient(135deg,#F0AD45,#D98C75)}.card-c{background:linear-gradient(135deg,#00BAAD,#B65A44)}.explore__entry-copy { position:absolute; right:0; bottom:0; left:0; padding:44rpx 20rpx 20rpx; background:linear-gradient(180deg,transparent,rgba(0,0,0,.72)); font-size:calc(34rpx * var(--fs)); font-weight:700; }.explore__entry-copy text { display:-webkit-box; overflow:hidden; color:rgba(255,255,255,.9); font-size:calc(24rpx * var(--fs)); font-weight:400; -webkit-line-clamp:2; -webkit-box-orient:vertical; }.explore__dots { position:absolute; top:20rpx; right:20rpx; }.explore__dot { display:inline-block; width:6rpx; height:6rpx; margin-left:6rpx; border-radius:50%; background:rgba(255,255,255,.45); }.explore__dot--active { background:var(--white); }
.explore__poi { position:fixed; z-index:20; bottom:calc(112rpx + env(safe-area-inset-bottom) + 24rpx); left:40rpx; display:flex; width:670rpx; height:260rpx; overflow:hidden; border-radius:24rpx; background:var(--white); box-shadow:var(--shadow-float); }.explore__poi-thumb { width:160rpx; flex:none; font-size:22rpx; text-align:center; }.explore__poi-main { min-width:0; flex:1; padding:18rpx 108rpx 18rpx 20rpx; }.explore__poi-name { font-size:calc(32rpx * var(--fs)); font-weight:600; }.explore__poi-tag { display:inline-block; margin-top:8rpx; padding:3rpx 12rpx; border-radius:8rpx; background:var(--tag); color:#4A2B1E; font-size:calc(22rpx * var(--fs)); }.explore__poi-distance { display:block; margin-top:4rpx; color:var(--ink-2); font-size:calc(22rpx * var(--fs)); }.explore__poi-actions { display:flex; height:88rpx; align-items:flex-end; justify-content:space-between; color:var(--terracotta-deep); font-size:calc(24rpx * var(--fs)); }.explore__poi-actions text { min-width:88rpx; text-align:center; }.explore__poi-close { position:absolute; top:8rpx; right:8rpx; display:flex; width:88rpx; height:88rpx; align-items:center; justify-content:center; color:var(--ink-2); font-size:48rpx; line-height:1; }
.explore__sheet-mask { position:fixed; z-index:110; inset:0; display:flex; align-items:flex-end; background:rgba(51,51,51,.3); }.explore__sheet { width:100%; padding:40rpx 48rpx calc(40rpx + env(safe-area-inset-bottom)); border-radius:40rpx 40rpx 0 0; box-sizing:border-box; background:var(--apricot); }.explore__sheet-title { font-size:calc(28rpx * var(--fs)); font-weight:600; }.explore__sheet-desc { margin-top:16rpx; font-size:calc(24rpx * var(--fs)); }.explore__sheet-allow { width:100%; height:88rpx; margin-top:32rpx; border-radius:44rpx; background:var(--terracotta-deep); color:var(--white); font-size:calc(28rpx * var(--fs)); line-height:88rpx; }.explore__sheet-later { margin-top:16rpx; text-align:center; font-size:calc(24rpx * var(--fs)); }
