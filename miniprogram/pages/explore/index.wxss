.page {
  min-height: 100vh;
  background: var(--paper-bg);
}

.explore-header {
  padding: 32rpx 40rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.explore-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary-brown-dark);
  letter-spacing: 6rpx;
}

.explore-subtitle {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.header-actions {
  display: flex;
  gap: 24rpx;
}

.header-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: rgba(139, 90, 43, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--primary-brown);
}

.map-container {
  position: relative;
  margin: 16rpx 32rpx 32rpx;
  height: 420rpx;
  border-radius: 48rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(139, 90, 43, 0.18);
  background: linear-gradient(145deg, #EDE0CB 0%, #DBC9AD 100%);
}

.map-bg {
  position: absolute;
  inset: 0;
  opacity: 0.6;
}

.map-street {
  position: absolute;
  background: rgba(139, 90, 43, 0.25);
  border-radius: 4rpx;
}

.map-street.h { height: 8rpx; }
.map-street.v { width: 8rpx; }

.map-area {
  position: absolute;
  border-radius: 24rpx;
  opacity: 0.5;
}

.map-icon {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  animation: pulse 2s ease-in-out infinite;
}

.map-icon.building {
  background: linear-gradient(135deg, #B8860B, #8B6508);
}

.map-icon.red {
  background: linear-gradient(135deg, #8B2635, #6B1E29);
}

.map-icon.religion {
  background: linear-gradient(135deg, #4A6741, #3A5233);
}

.map-icon.route {
  background: linear-gradient(135deg, #5C4A7A, #4A3B63);
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  }
  50% {
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.35);
  }
}

.map-legend {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  background: rgba(250, 243, 231, 0.92);
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  display: flex;
  gap: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text-medium);
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.quick-cards {
  padding: 0 32rpx 180rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.quick-card {
  background: linear-gradient(145deg, #fff, var(--warm-cream));
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
}

.quick-card .emoji {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.quick-card .title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 6rpx;
}

.quick-card .desc {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.4;
}

.ai-fab {
  position: fixed;
  right: 32rpx;
  bottom: 176rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 6rpx 20rpx rgba(139, 90, 43, 0.4);
  z-index: 100;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}
