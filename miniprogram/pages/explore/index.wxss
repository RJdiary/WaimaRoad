.page { min-height: 100vh; padding: var(--miniapp-action-clearance) 0 176rpx; background: var(--paper-bg); }

.explore-header { padding: 0 40rpx 24rpx; }
.explore-title { color: var(--primary-brown-dark); font-size: 52rpx; line-height: 1.2; font-weight: 700; letter-spacing: 6rpx; }
.explore-subtitle { margin-top: 10rpx; color: var(--text-light); font-size: 25rpx; letter-spacing: 1rpx; }

.map-section, .quick-section { padding: 0 32rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: baseline; margin: 0 8rpx 16rpx; }
.section-title { color: var(--text-dark); font-size: 32rpx; font-weight: 600; }
.section-note { color: var(--text-light); font-size: 22rpx; }
.explore-map { width: 100%; height: 520rpx; border-radius: 28rpx; box-shadow: 0 8rpx 26rpx rgba(113, 83, 54, .16); }

.quick-section { margin-top: 38rpx; }
.quick-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.quick-card { min-height: 172rpx; padding: 24rpx 20rpx; border-radius: 24rpx; background: #fff; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; box-shadow: 0 5rpx 16rpx rgba(87, 75, 62, .1); }
.quick-card:active { opacity: .76; transform: scale(.98); }
.quick-icon { width: 60rpx; height: 60rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; background: rgba(204, 121, 91, .14); color: var(--primary-brown-dark); font-size: 36rpx; }
.quick-title { color: var(--text-dark); font-size: 28rpx; font-weight: 600; }
.quick-desc { margin-top: 6rpx; color: var(--text-light); font-size: 20rpx; line-height: 1.45; }
.quick-card.red .quick-icon { background: rgba(232, 93, 81, .14); color: var(--accent-red); }
.quick-card.ai .quick-icon { background: rgba(112, 207, 167, .17); color: #398F6A; }
.quick-card.route .quick-icon { background: rgba(244, 166, 50, .17); color: #C98316; }
