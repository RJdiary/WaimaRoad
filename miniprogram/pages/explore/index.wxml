<view class="page">
  <view class="explore-header">
    <view>
      <view class="explore-title serif">探索</view>
      <view class="explore-subtitle">{{currentTime}}</view>
    </view>
    <view class="header-actions">
      <view class="header-btn">🔍</view>
      <view class="header-btn">📢</view>
    </view>
  </view>

  <view class="map-container">
    <view class="map-bg">
      <view class="map-street h" style="top:30%;left:10%;width:80%"></view>
      <view class="map-street h" style="top:60%;left:5%;width:90%"></view>
      <view class="map-street v" style="left:25%;top:10%;height:80%"></view>
      <view class="map-street v" style="left:65%;top:15%;height:70%"></view>
      <view class="map-area" style="top:12%;left:8%;width:30%;height:22%;background:rgba(184,134,11,0.3)"></view>
      <view class="map-area" style="top:35%;left:40%;width:35%;height:20%;background:rgba(139,38,53,0.25)"></view>
      <view class="map-area" style="top:65%;left:15%;width:28%;height:20%;background:rgba(74,103,65,0.25)"></view>
    </view>

    <view class="map-icon building" style="top:18%;left:22%" bindtap="goToHeritage" data-category="building">🏛</view>
    <view class="map-icon red" style="top:42%;left:55%" bindtap="goToHeritage" data-category="red">⭐</view>
    <view class="map-icon religion" style="top:72%;left:28%" bindtap="goToHeritage" data-category="religion">⛩</view>
    <view class="map-icon building" style="top:25%;left:75%" bindtap="goToHeritage" data-category="building">🏯</view>
    <view class="map-icon route" style="top:50%;left:20%" bindtap="goToStreet">🧭</view>

    <view class="map-legend">
      <view class="legend-item"><span class="legend-dot" style="background:var(--accent-gold)"></span>建筑</view>
      <view class="legend-item"><span class="legend-dot" style="background:var(--accent-red)"></span>红色</view>
      <view class="legend-item"><span class="legend-dot" style="background:var(--accent-green)"></span>宗教</view>
    </view>
  </view>

  <view class="quick-cards">
    <view class="quick-card" bindtap="goToHeritage" data-category="building">
      <view class="emoji">🏛</view>
      <view class="title serif">建筑遗存</view>
      <view class="desc">探寻百年历史建筑之美</view>
    </view>
    <view class="quick-card" bindtap="goToHeritage" data-category="red">
      <view class="emoji">⭐</view>
      <view class="title serif">红色记忆</view>
      <view class="desc">传承革命精神与红色文化</view>
    </view>
    <view class="quick-card" bindtap="goToAiCompare">
      <view class="emoji">🖼</view>
      <view class="title serif">AI修复影像</view>
      <view class="desc">让历史影像重焕新生</view>
    </view>
    <view class="quick-card" bindtap="goToStreet">
      <view class="emoji">🧭</view>
      <view class="title serif">主题走街</view>
      <view class="desc">规划专属文化探索路线</view>
    </view>
  </view>

  <ai-chat></ai-chat>
</view>
