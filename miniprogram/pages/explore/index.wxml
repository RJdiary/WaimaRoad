<view class="page page--tab explore" style="{{pageStyle}}">
  <view class="explore__header {{collapsed ? 'explore__header--collapsed' : ''}}"><view class="explore__collage"><view class="explore__timeline"></view><view class="explore__photo explore__photo--1"></view><view class="explore__photo explore__photo--2"></view><view class="explore__photo explore__photo--3"></view><view class="explore__photo explore__photo--4"></view></view><view class="explore__calligraphy text-calligraphy"><text>埠藏史库</text><text>街绘行图</text></view></view>
  <view class="explore__map-wrap {{mapFullscreen ? 'explore__map-wrap--fullscreen' : ''}}"><map id="exploreMap" latitude="{{mapCenter.latitude}}" longitude="{{mapCenter.longitude}}" scale="16" markers="{{markers}}" controls="{{controls}}" show-location enable-3D="{{false}}" show-scale="{{false}}" enable-scroll enable-zoom bindmarkertap="onMarkerTap" bindtap="onMapTap" style="width:100%;height:100%;"></map><view wx:if="{{mapLoading}}" class="explore__map-loading">正在展开老地图…</view><view class="explore__map-tools"><view class="explore__map-tool" bindtap="onLocate">◎</view><view class="explore__map-tool" bindtap="onLayerTip">▤</view><view class="explore__map-tool" bindtap="onFullscreen">⛶</view></view><view wx:if="{{mapFullscreen}}" class="explore__exit" bindtap="onExitFullscreen">退出全屏</view></view>
  <view class="explore__search {{searchFixed ? 'explore__search--fixed' : ''}}" style="{{searchFixed ? 'top:' + (statusBarHeight + 8) + 'px' : ''}}" bindtap="onSearch"><view class="explore__search-ring"></view></view>
  <view wx:if="{{locationDenied}}" class="explore__location-tip"><text>开启定位，发现身边的史迹</text><text bindtap="onOpenSetting">去开启</text></view>
  <view class="explore__entries"><view wx:for="{{entryCards}}" wx:for-item="card" wx:key="title" class="explore__entry tap-scale" data-index="{{index}}" bindtap="onEntryTap"><swiper autoplay interval="4000" circular bindchange="onEntryChange" data-index="{{index}}"><swiper-item wx:for="{{card.colors}}" wx:for-item="color" wx:key="index"><view class="explore__entry-bg {{color}}"></view></swiper-item></swiper><view class="explore__dots"><text wx:for="{{card.colors}}" wx:for-item="color" wx:key="index" class="explore__dot {{index === card.active ? 'explore__dot--active' : ''}}"></text></view><view class="explore__entry-copy"><view>{{card.title}}</view><text>{{card.subtitle}}</text></view></view></view>
  <map-poi-sheet visible="{{!!selectedSite}}" poi="{{selectedSite}}" bind:close="closePoi" bind:detail="onPoiDetail" bind:checkin="onPoiCheckin" bind:favorite="onPoiFavorite" />
  <view wx:if="{{locationTipVisible}}" class="explore__sheet-mask"><view class="explore__sheet" style="width: 749rpx; height: 510rpx; display: block; box-sizing: border-box"><view class="explore__sheet-title">为什么要用你的位置</view><view class="explore__sheet-desc">只为展示附近史迹与到点打卡，不会在后台持续定位。</view><button class="explore__sheet-allow tap" bindtap="onAllowLocation">允许定位</button><view class="explore__sheet-later tap" bindtap="onBrowseFirst">先逛逛</view></view></view>
</view>
