<view class="page">
  <view class="explore-header">
    <view>
      <view class="explore-title serif">埠藏史库</view>
      <view class="explore-subtitle">外马路 · 城市历史文化探索</view>
    </view>
  </view>

  <view class="map-section">
    <view class="section-heading">
      <view class="section-title serif">外马路地图</view>
      <view class="section-note">拖动、缩放并点击点位</view>
    </view>
    <map
      id="exploreMap"
      class="explore-map"
      latitude="{{mapLatitude}}"
      longitude="{{mapLongitude}}"
      scale="{{mapScale}}"
      markers="{{mapMarkers}}"
      show-location="true"
      enable-zoom="true"
      enable-scroll="true"
      bindmarkertap="onMapMarkerTap"
    ></map>
  </view>

  <view class="quick-section">
    <view class="section-heading">
      <view class="section-title serif">按主题探索</view>
      <view class="section-note">选择你感兴趣的内容</view>
    </view>
    <view class="quick-cards">
      <view class="quick-card diplomacy" bindtap="goToHeritage" data-category="diplomacy">
        <view class="quick-icon">⚓</view>
        <view><view class="quick-title">开埠外交</view><view class="quick-desc">海关、领事馆与口岸记忆</view></view>
      </view>
      <view class="quick-card red" bindtap="goToHeritage" data-category="red">
        <view class="quick-icon">★</view>
        <view><view class="quick-title">红色革命</view><view class="quick-desc">追寻城市的革命足迹</view></view>
      </view>
      <view class="quick-card ai" bindtap="goToAiCompare">
        <view class="quick-icon">✦</view>
        <view><view class="quick-title">AI辅助复原</view><view class="quick-desc">对照旧影像与复原画面</view></view>
      </view>
      <view class="quick-card route" bindtap="goToStreet">
        <view class="quick-icon">⌖</view>
        <view><view class="quick-title">主题走街</view><view class="quick-desc">选择路线，边走边读</view></view>
      </view>
    </view>
  </view>

  <ai-chat></ai-chat>
</view>
