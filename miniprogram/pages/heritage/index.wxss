.page {
  min-height: 100vh;
  background: var(--paper-bg);
  overflow-x: hidden;
}

.heritage-header {
  padding: var(--miniapp-action-clearance) 48rpx 18rpx;
  position: relative;
  background: transparent;
}

.heritage-header .title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary-brown-dark);
  letter-spacing: 4rpx;
}

.heritage-header .subtitle {
  font-size: 28rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.header-book { position: absolute; right: 72rpx; top: calc(var(--miniapp-action-clearance) - 6rpx); width: 90rpx; height: 90rpx; border: 4rpx solid var(--text-medium); border-radius: 50% 50% 44% 44%; color: var(--primary-brown-dark); font-size: 72rpx; line-height: 70rpx; text-align: center; transform: rotate(-10deg); opacity: .74; }

.category-tabs {
  white-space: nowrap;
  padding: 16rpx 48rpx 24rpx;
}

.category-tab {
  display: inline-block;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--text-medium);
  background: #D9D9D9;
  margin-right: 14rpx;
}

.category-tab.active {
  background: #9B9B9B;
  color: #fff;
  box-shadow: none;
}

.heritage-list {
  padding: 0 44rpx 180rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.heritage-card {
  background: #fff;
  border-radius: 34rpx;
  overflow: hidden;
  box-shadow: none;
}

.heritage-card-img {
  height: 290rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heritage-cover { width: 100%; height: 100%; display: block; }

.heritage-card-img.ai-restored {
  background: linear-gradient(135deg, #2D2418, #5C4A3A);
}

.heritage-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #fff;
}

.heritage-badge.diplomacy {
  background: #F0B367;
}

.heritage-badge.commerce { background: #B77A3A; }
.heritage-badge.culture { background: #6B5C8A; }

.heritage-badge.red {
  background: var(--accent-red);
}

.heritage-badge.religion {
  background: var(--accent-green);
}

.heritage-badge.ai {
  background: linear-gradient(135deg, #5C4A7A, #7A5C99);
}

.heritage-card-body {
  padding: 24rpx 32rpx 26rpx;
  background: #D98970;
}

.heritage-card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E1918;
  margin-bottom: 12rpx;
}

.heritage-card-desc {
  font-size: 24rpx;
  color: #1E1918;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.heritage-card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(30, 25, 24, 0.65);
}

.meta-left {
  font-size: 22rpx;
  color: #1E1918;
  display: flex;
  gap: 24rpx;
}

.meta-right {
  font-size: 32rpx;
  color: var(--text-light);
}

.empty-state {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-light);
}
