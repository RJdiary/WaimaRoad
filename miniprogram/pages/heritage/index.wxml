<view class="page">
  <view class="heritage-header">
    <view class="title serif">埠藏史库</view>
    <view class="header-book">⌁</view>
    <view class="subtitle">外马路 · 现存与消失的人文空间</view>
  </view>

  <scroll-view scroll-x="true" class="category-tabs" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="category-tab {{activeCategory === item.key ? 'active' : ''}}"
      bindtap="onCategoryTap"
      data-key="{{item.key}}"
    >{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{list.length > 0}}" class="heritage-list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="heritage-card"
      bindtap="goToDetail"
      data-id="{{item.id}}"
      data-category="{{item.category}}"
    >
      <view class="heritage-card-img {{item.isAiRestored ? 'ai-restored' : ''}}">
        <image wx:if="{{item.id === 1}}" class="heritage-cover" src="../../images/design/heritage-customs.jpg" mode="aspectFill"></image>
        <image wx:elif="{{item.id === 5 || item.id === 6}}" class="heritage-cover" src="../../images/design/heritage-ancestral.jpg" mode="aspectFill"></image>
        <image wx:elif="{{item.category === 'red'}}" class="heritage-cover" src="../../images/design/explore-revolution.jpg" mode="aspectFill"></image>
        <image wx:elif="{{item.category === 'ai'}}" class="heritage-cover" src="../../images/design/explore-restoration.jpg" mode="aspectFill"></image>
        <image wx:else class="heritage-cover" src="../../images/design/explore-port.jpg" mode="aspectFill"></image>
        <view class="heritage-badge {{item.category}}">{{item.categoryName}}</view>
      </view>
      <view class="heritage-card-body">
        <view class="heritage-card-title serif">{{item.title}}</view>
        <view class="heritage-card-desc">{{item.summary}}</view>
        <view class="heritage-card-meta">
          <view class="meta-left">
            <text>👁 {{item.views}}</text>
            <text>⭐ {{item.favorites}}</text>
          </view>
          <view class="meta-right">›</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <view class="empty-emoji">📚</view>
    <view class="empty-text">暂无相关史料</view>
  </view>

  <ai-chat></ai-chat>
</view>
