.detail-page {
  background: var(--paper-bg);
  min-height: 100vh;
}

.detail-hero {
  height: 480rpx;
  margin-top: var(--miniapp-action-clearance);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-emoji {
  font-size: 160rpx;
}

.detail-back {
  position: absolute;
  left: 32rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.back-icon {
  color: #fff;
  font-size: 48rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.detail-actions {
  position: absolute;
  right: 32rpx;
  display: flex;
  gap: 20rpx;
  z-index: 10;
}

.detail-action {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-action text {
  color: #fff;
  font-size: 32rpx;
}

.detail-content {
  padding: 32rpx;
}

.detail-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 16rpx;
}

.detail-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.detail-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: var(--warm-cream);
}

.detail-tag text {
  font-size: 22rpx;
  color: var(--primary-brown);
}

.detail-section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-brown-dark);
  margin-top: 48rpx;
  margin-bottom: 20rpx;
}

.section-bar {
  width: 6rpx;
  height: 32rpx;
  background: var(--primary-brown);
  border-radius: 3rpx;
}

.detail-text {
  font-size: 28rpx;
  color: var(--text-medium);
  line-height: 1.8;
  text-align: justify;
}

.audio-player {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, var(--warm-cream), var(--warm-cream-dark));
  border-radius: 24rpx;
  margin-top: 8rpx;
}

.play-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(139, 90, 43, 0.3);
}

.play-btn text {
  color: #fff;
  font-size: 32rpx;
}

.audio-info {
  flex: 1;
}

.audio-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-dark);
  margin-bottom: 8rpx;
}

.audio-progress {
  height: 8rpx;
  background: rgba(139, 90, 43, 0.2);
  border-radius: 4rpx;
  overflow: hidden;
}

.audio-progress-bar {
  height: 100%;
  background: var(--primary-brown);
  border-radius: 4rpx;
}

.audio-duration {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  margin-top: 8rpx;
}

.image-grid-item {
  aspect-ratio: 1;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.grid-emoji {
  font-size: 48rpx;
}
