<view class="detail-page">
  <view class="detail-hero" style="{{heritage.imgStyle || 'background:linear-gradient(135deg,#8B6508,#B8860B)'}}">
    <text class="hero-emoji">{{heritage.emoji || '🏛'}}</text>
    <view class="detail-back" style="top:{{actionTop}}px" bindtap="onBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="detail-actions" style="top:{{actionTop}}px">
      <view class="detail-action" bindtap="onToggleFavorite">
        <text>{{isFavorited ? '⭐' : '☆'}}</text>
      </view>
      <view class="detail-action" bindtap="onShare">
        <text>↗</text>
      </view>
    </view>
  </view>

  <view class="detail-content">
    <view class="detail-title serif">{{heritage.title || '史料详情'}}</view>

    <view class="detail-tags">
      <view class="detail-tag">
        <text>{{heritage.categoryEmoji || '🏛'}} {{heritage.categoryName || '建筑'}}</text>
      </view>
      <view class="detail-tag">
        <text>📍 {{heritage.location || '天桥区'}}</text>
      </view>
      <view class="detail-tag">
        <text>📅 {{heritage.era || '1904年'}}</text>
      </view>
    </view>

    <view class="detail-section-title serif">
      <view class="section-bar"></view>
      <text>简介</text>
    </view>
    <view class="detail-text">
      <text>{{heritage.detail || heritage.summary || '暂无详细介绍。'}}</text>
    </view>

    <view class="detail-section-title serif">
      <view class="section-bar"></view>
      <text>语音讲解</text>
    </view>
    <view class="audio-player">
      <view class="play-btn" bindtap="onTogglePlay">
        <text>{{isPlaying ? '❚❚' : '▶'}}</text>
      </view>
      <view class="audio-info">
        <view class="audio-title">{{heritage.title || '史料'}}历史讲解</view>
        <view class="audio-progress">
          <view class="audio-progress-bar" style="width:35%"></view>
        </view>
        <view class="audio-duration">02:45 / 08:32</view>
      </view>
    </view>

    <view class="detail-section-title serif">
      <view class="section-bar"></view>
      <text>相关图片</text>
    </view>
    <view class="image-grid">
      <view class="image-grid-item" style="background:linear-gradient(135deg,#C4A882,#8B6508)">
        <text class="grid-emoji">{{heritage.emoji || '🏛'}}</text>
      </view>
      <view class="image-grid-item" style="background:linear-gradient(135deg,#B8956B,#8B6508)">
        <text class="grid-emoji">🕰</text>
      </view>
      <view class="image-grid-item" style="background:linear-gradient(135deg,#A8825A,#6B4226)">
        <text class="grid-emoji">🚂</text>
      </view>
    </view>
  </view>
</view>
