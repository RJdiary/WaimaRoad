.page {
  min-height: 100vh;
  background: var(--paper-bg);
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
  margin-bottom: 32rpx;
  overflow: hidden;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-brown-dark);
  padding: 32rpx 36rpx 16rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.row.clickable {
  cursor: pointer;
}

.row.clickable:active {
  background: rgba(139, 90, 43, 0.04);
}

.row-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(139, 90, 43, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.row-info {
  flex: 1;
}

.row-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-dark);
}

.row-desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-text {
  font-size: 24rpx;
  color: var(--text-light);
}

.row-arrow {
  color: var(--text-light);
  font-size: 32rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--warm-cream), var(--warm-cream-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 12rpx;
}
