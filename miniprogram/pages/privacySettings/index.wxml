<view class="page">
  <view class="card">
    <view class="card-title serif">个人资料</view>
    <view class="row clickable" bindtap="onEditProfile">
      <view class="row-left">
        <view class="row-icon">👤</view>
        <view class="row-info">
          <view class="row-title">{{userInfo.nickName || '未登录'}}</view>
          <view class="row-desc">点击编辑个人资料</view>
        </view>
      </view>
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-placeholder">👤</view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title serif">授权管理</view>
    <view class="row clickable" data-type="notify" bindtap="goAuthSetting">
      <view class="row-left">
        <view class="row-icon">🔔</view>
        <view class="row-title">通知权限</view>
      </view>
      <view class="row-right">
        <view class="status-text">{{notifyEnabled ? '已开启' : '未开启'}}</view>
        <view class="row-arrow">›</view>
      </view>
    </view>
    <view class="row clickable" data-type="location" bindtap="goAuthSetting">
      <view class="row-left">
        <view class="row-icon">📍</view>
        <view class="row-title">定位权限</view>
      </view>
      <view class="row-right">
        <view class="status-text">{{locationEnabled ? '已开启' : '未开启'}}</view>
        <view class="row-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title serif">消息订阅</view>
    <view class="row">
      <view class="row-left">
        <view class="row-info">
          <view class="row-title">新史料上线通知</view>
          <view class="row-desc">有新的史料内容时第一时间通知您</view>
        </view>
      </view>
      <switch checked="{{subscriptions.newHeritage}}" color="#8B5A2B" data-type="newHeritage" bindchange="onSubscriptionChange" />
    </view>
    <view class="row">
      <view class="row-left">
        <view class="row-info">
          <view class="row-title">走街活动提醒</view>
          <view class="row-desc">走街活动开始前提醒您参加</view>
        </view>
      </view>
      <switch checked="{{subscriptions.streetActivity}}" color="#8B5A2B" data-type="streetActivity" bindchange="onSubscriptionChange" />
    </view>
    <view class="row">
      <view class="row-left">
        <view class="row-info">
          <view class="row-title">打卡成就通知</view>
          <view class="row-desc">获得新成就时通知您</view>
        </view>
      </view>
      <switch checked="{{subscriptions.achievement}}" color="#8B5A2B" data-type="achievement" bindchange="onSubscriptionChange" />
    </view>
  </view>
</view>
