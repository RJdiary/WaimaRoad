<view class="page">
  <view class="street-header">
    <view class="street-sign">↔</view>
    <view class="title serif">街绘行图</view>
    <view class="street-pin">⌖</view>
    <view class="subtitle">四条 Citywalk，边走边读外马路</view>
  </view>

  <view class="route-cards">
    <view class="route-card" wx:for="{{routes}}" wx:key="id" bindtap="goToStreetMap" data-route-id="{{item.id}}">
      <view class="route-card-top">
        <view class="route-card-name serif">{{item.name}}</view>
        <view class="route-theme-badge {{item.themeColor}}">{{item.theme}}</view>
      </view>

      <view class="route-card-info">
        <view class="route-info-item">📍 {{item.pointCount}}个点位</view>
        <view class="route-info-item">⏱ 约{{item.duration}}小时</view>
        <view class="route-info-item">🚶 {{item.distance}}公里</view>
      </view>
      <view class="route-desc">{{item.description}}</view>

      <view class="route-divider"></view>

      <view class="route-points">
        <block wx:for="{{item.points}}" wx:for-item="point" wx:for-index="idx" wx:key="*this">
          <view class="route-point-dot">{{point}}</view>
          <view class="route-point-line" wx:if="{{idx < item.points.length - 1}}"></view>
        </block>
      </view>

      <view class="route-start-btn" catchtap="goToStreetMap" data-route-id="{{item.id}}">
        <text class="serif">{{item.startBtnText}}</text>
      </view>
    </view>
  </view>

  <ai-chat></ai-chat>
</view>
