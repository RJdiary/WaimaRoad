.page {
  min-height: 100vh;
  background: var(--paper-bg);
}

.street-header {
  padding: calc(var(--miniapp-action-clearance) + 8rpx) 48rpx 34rpx 146rpx;
  background: transparent;
  position: relative;
}

.street-header .title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary-brown-dark);
  letter-spacing: 4rpx;
}

.street-header .subtitle {
  font-size: 28rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.street-sign { position: absolute; left: 48rpx; top: calc(var(--miniapp-action-clearance) + 10rpx); width: 68rpx; height: 68rpx; border-radius: 12rpx; background: #D7654B; color: #FFF4D9; text-align: center; line-height: 68rpx; font-size: 54rpx; transform: rotate(-8deg); box-shadow: 0 5rpx 0 #BF513C; }
.street-pin { position: absolute; right: 54rpx; top: calc(var(--miniapp-action-clearance) + 8rpx); width: 68rpx; height: 68rpx; border: 5rpx solid #E88462; border-radius: 50%; color: #E88462; font-size: 64rpx; line-height: 56rpx; text-align: center; }

.route-cards {
  padding: 24rpx 32rpx 180rpx;
  display: flex;
  flex-direction: column;
}

.route-card {
  background: #FFE5B8;
  border-radius: 36rpx;
  padding: 36rpx;
  box-shadow: none;
  margin-bottom: 28rpx;
}

.route-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.route-card-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.route-theme-badge {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

.route-theme-badge.red {
  background: linear-gradient(135deg, #8B2635, #6B1E29);
}

.route-theme-badge.gold {
  background: linear-gradient(135deg, #B8860B, #8B6508);
}

.route-theme-badge.green {
  background: linear-gradient(135deg, #4A6741, #3A5233);
}

.route-card-info {
  display: flex;
  gap: 40rpx;
  margin-bottom: 28rpx;
}

.route-desc { font-size: 24rpx; color: var(--text-light); margin-top: 16rpx; line-height: 1.5; }

.route-info-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-medium);
}

.route-divider {
  border-top: 2rpx dashed rgba(139, 90, 43, 0.15);
  margin-bottom: 28rpx;
}

.route-points {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.route-point-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-brown-light), var(--primary-brown));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.route-point-line {
  width: 32rpx;
  height: 4rpx;
  background: rgba(139, 90, 43, 0.3);
}

.route-start-btn {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
  text-align: center;
  letter-spacing: 6rpx;
  font-size: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 90, 43, 0.3);
}
