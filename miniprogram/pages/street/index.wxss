.page {
  min-height: 100vh;
  background: var(--paper-bg);
}

.street-header {
  padding: 32rpx 40rpx;
  background: linear-gradient(180deg, var(--warm-cream) 0%, transparent 100%);
}

.street-header .title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--primary-brown-dark);
  letter-spacing: 4rpx;
}

.street-header .subtitle {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.route-cards {
  padding: 24rpx 32rpx 180rpx;
  display: flex;
  flex-direction: column;
}

.route-card {
  background: #fff;
  border-radius: 36rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
  margin-bottom: 28rpx;
}

.route-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.route-card-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.route-theme-badge {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

.route-theme-badge.red {
  background: linear-gradient(135deg, #8B2635, #6B1E29);
}

.route-theme-badge.gold {
  background: linear-gradient(135deg, #B8860B, #8B6508);
}

.route-theme-badge.green {
  background: linear-gradient(135deg, #4A6741, #3A5233);
}

.route-card-info {
  display: flex;
  gap: 40rpx;
  margin-bottom: 28rpx;
}

.route-info-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-medium);
}

.route-divider {
  border-top: 2rpx dashed rgba(139, 90, 43, 0.15);
  margin-bottom: 28rpx;
}

.route-points {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.route-point-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-brown-light), var(--primary-brown));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.route-point-line {
  width: 32rpx;
  height: 4rpx;
  background: rgba(139, 90, 43, 0.3);
}

.route-start-btn {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
  text-align: center;
  letter-spacing: 6rpx;
  font-size: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 90, 43, 0.3);
}
