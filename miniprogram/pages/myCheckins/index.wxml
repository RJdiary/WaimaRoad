<view class="page">
  <view wx:if="{{!isEmpty}}" class="list-container">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="card"
      bindtap="goToDetail"
      data-id="{{item.pointId}}"
      data-category="{{item.category}}"
    >
      <view class="card-img {{item.isAiRestored ? 'ai-restored' : ''}}" style="{{item.imgStyle}}">
        {{item.emoji}}
        <view class="card-badge {{item.category}}">{{item.categoryName}}</view>
      </view>
      <view class="card-body">
        <view class="card-title serif">{{item.pointName}}</view>
        <view class="card-desc">{{item.summary}}</view>
        <view class="card-meta">
          <view class="meta-left">
            <text class="meta-item">📍 {{item.location}}</text>
            <text class="meta-item">🕐 {{item.checkinTime}}</text>
          </view>
          <view class="meta-right">›</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <view class="empty-emoji">📍</view>
    <view class="empty-title">暂无打卡记录</view>
    <view class="empty-subtitle">开启走街探索吧</view>
    <button class="explore-btn" bindtap="goStreet">去走街</button>
  </view>
</view>
