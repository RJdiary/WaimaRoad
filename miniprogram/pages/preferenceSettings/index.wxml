<view class="page">
  <view class="tip">选择您感兴趣的分类，我们将为您推荐相关内容</view>

  <view class="category-wrap">
    <view
      class="category-tag {{item.checked ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onCategoryTap"
    >
      <text>{{item.name}}</text>
      <text wx:if="{{item.checked}}" class="check-icon">✓</text>
    </view>
  </view>

  <view class="btn-wrap">
    <button class="save-btn serif" bindtap="onSave">保存</button>
  </view>
</view>
