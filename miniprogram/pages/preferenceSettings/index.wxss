.page {
  min-height: 100vh;
  background: var(--paper-bg);
  padding: 32rpx;
  box-sizing: border-box;
}

.tip {
  font-size: 24rpx;
  color: var(--text-light);
  padding: 16rpx 8rpx 32rpx;
  line-height: 1.6;
}

.category-wrap {
  display: flex;
  flex-wrap: wrap;
  padding: 0 8rpx;
}

.category-tag {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin: 12rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(139, 90, 43, 0.2);
  background: #fff;
  color: var(--text-light);
  font-size: 28rpx;
  transition: all 0.25s ease;
}

.category-tag.active {
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
  border-color: transparent;
}

.check-icon {
  margin-left: 8rpx;
  font-size: 26rpx;
}

.btn-wrap {
  padding: 60rpx 8rpx 40rpx;
}

.save-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  border: none;
}

.save-btn:active {
  opacity: 0.85;
}
