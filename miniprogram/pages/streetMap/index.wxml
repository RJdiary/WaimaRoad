<view class="page">
  <view class="custom-nav">
    <view class="status-bar-placeholder"></view>
    <view class="nav-content">
      <view class="nav-back" bindtap="onBack">
        <text class="back-icon">‹</text>
      </view>
      <view class="nav-center">
        <view class="route-name serif">{{route.name}}</view>
        <view class="route-progress-text">已完成 {{visitedCount}}/{{points.length}}</view>
      </view>
      <view class="nav-right"></view>
    </view>
  </view>

  <view class="content">
    <view class="map-wrapper">
      <map
        id="streetMap"
        class="street-map"
        latitude="{{latitude}}"
        longitude="{{longitude}}"
        scale="{{scale}}"
        markers="{{markers}}"
        show-location="true"
        bindmarkertap="onMarkerTap"
      ></map>
    </view>

    <view class="progress-card">
      <view class="progress-header">
        <text class="progress-title">走街进度</text>
        <text class="progress-percent">{{progress}}%</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width:{{progress}}%"></view>
      </view>
    </view>

    <view class="points-section">
      <view class="section-title serif">点位列表</view>
      <view class="points-list">
        <view
          class="point-item {{item.status}}"
          wx:for="{{points}}"
          wx:key="id"
          bindtap="onPointTap"
          data-point-id="{{item.id}}"
        >
          <view class="point-index {{item.status}}">
            <text wx:if="{{item.status === 'visited'}}">✓</text>
            <text wx:else>{{index + 1}}</text>
          </view>
          <view class="point-info">
            <view class="point-name">{{item.name}}</view>
          </view>
          <view class="point-status-tag {{item.status}}">
            <text wx:if="{{item.status === 'visited'}}">已打卡</text>
            <text wx:elif="{{item.status === 'current'}}">📍 当前</text>
            <text wx:else>未完成</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="popup-mask" wx:if="{{showPopup}}" bindtap="closePopup"></view>
  <view class="point-popup {{showPopup ? 'show' : ''}}" wx:if="{{currentPoint}}">
    <view class="popup-close" catchtap="closePopup">
      <text>✕</text>
    </view>
    <view class="popup-title serif">{{currentPoint.name}}</view>

    <view class="popup-media">
      <view class="popup-media-item map">
        <text class="media-emoji">📍</text>
      </view>
      <view class="popup-media-item image">
        <text class="media-emoji">🖼</text>
      </view>
    </view>

    <view class="popup-summary">
      <text>{{currentPoint.summary}}</text>
    </view>

    <view class="popup-media-btns">
      <view class="popup-media-btn" bindtap="onPlayVideo">
        <text>🎬 AI视频</text>
      </view>
      <view class="popup-media-btn" bindtap="onPlayAudio">
        <text>🎧 语音讲解</text>
      </view>
    </view>

    <view class="popup-action-btns">
      <view class="popup-btn primary" bindtap="goToHeritage">
        <text>查看具体史料信息</text>
      </view>
      <view class="popup-btn secondary" bindtap="goToExplore">
        <text>在地图上查看</text>
      </view>
    </view>

    <view class="popup-checkin-btn" wx:if="{{currentPoint.status !== 'visited'}}" bindtap="checkin">
      <text>📍 打卡此点位</text>
    </view>
  </view>
</view>
