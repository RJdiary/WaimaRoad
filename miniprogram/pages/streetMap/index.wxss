.page {
  min-height: 100vh;
  background: var(--paper-bg);
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(180deg, var(--warm-cream) 0%, var(--paper-bg) 100%);
}

.status-bar-placeholder {
  height: 88rpx;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: var(--text-dark);
  line-height: 1;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.route-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary-brown-dark);
}

.route-progress-text {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.nav-right {
  width: 64rpx;
}

.content {
  padding-top: 140rpx;
  padding-bottom: 40rpx;
}

.map-wrapper {
  margin: 0 24rpx 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(139, 90, 43, 0.18);
}

.street-map {
  width: 100%;
  height: 500rpx;
}

.progress-card {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 32rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-dark);
}

.progress-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-brown);
}

.progress-track {
  height: 16rpx;
  background: rgba(139, 90, 43, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-brown-light), var(--primary-brown));
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.points-section {
  padding: 0 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 16rpx;
}

.points-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.point-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
}

.point-item.current {
  background: linear-gradient(135deg, var(--warm-cream), #fff);
  border: 2rpx solid rgba(139, 38, 53, 0.3);
  box-shadow: 0 8rpx 32rpx rgba(139, 90, 43, 0.18);
}

.point-index {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.point-index.visited {
  background: rgba(74, 103, 65, 0.15);
  color: var(--accent-green);
}

.point-index.current {
  background: linear-gradient(135deg, var(--accent-red), #6B1E29);
  color: #fff;
}

.point-index.pending {
  background: rgba(139, 90, 43, 0.1);
  color: var(--text-light);
}

.point-info {
  flex: 1;
}

.point-name {
  font-size: 28rpx;
  color: var(--text-dark);
}

.point-item.visited .point-name {
  color: var(--text-light);
  text-decoration: line-through;
}

.point-item.current .point-name {
  font-weight: 500;
}

.point-status-tag {
  font-size: 22rpx;
  flex-shrink: 0;
}

.point-status-tag.visited {
  color: var(--accent-green);
}

.point-status-tag.current {
  color: var(--accent-red);
}

.point-status-tag.pending {
  color: var(--text-light);
}

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.point-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 32rpx 48rpx;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.35s ease-out;
  max-height: 85vh;
  overflow-y: auto;
}

.point-popup.show {
  transform: translateY(0);
}

.popup-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(139, 90, 43, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-light);
}

.popup-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 24rpx;
  padding-right: 80rpx;
}

.popup-media {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.popup-media-item {
  aspect-ratio: 1.3;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-media-item.map {
  background: linear-gradient(135deg, #A8C4A0, #6B8B5A);
}

.popup-media-item.image {
  background: linear-gradient(135deg, #E8D4A0, #B8860B);
}

.media-emoji {
  font-size: 60rpx;
}

.popup-summary {
  font-size: 26rpx;
  color: var(--text-medium);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.popup-media-btns {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.popup-media-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(139, 90, 43, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--primary-brown);
  font-weight: 500;
}

.popup-action-btns {
  display: flex;
  gap: 20rpx;
}

.popup-btn {
  flex: 1;
  padding: 26rpx;
  border-radius: 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
}

.popup-btn.primary {
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
}

.popup-btn.secondary {
  background: rgba(139, 90, 43, 0.1);
  color: var(--primary-brown-dark);
}

.popup-checkin-btn {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--accent-red), #6B1E29);
  color: #fff;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(139, 38, 53, 0.35);
}
