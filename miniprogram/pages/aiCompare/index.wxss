.page {
  min-height: 100vh;
  background: var(--paper-bg);
}

.safe-area {
  width: 100%;
  height: var(--miniapp-action-clearance);
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding-top: env(safe-area-inset-top);
}

.back-btn {
  margin-left: 32rpx;
  margin-top: 20rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(139, 90, 43, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: var(--primary-brown);
  line-height: 1;
  margin-top: -4rpx;
}

.header {
  text-align: center;
  padding: 20rpx 40rpx 40rpx;
}

.header .title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--primary-brown-dark);
  letter-spacing: 4rpx;
}

.header .subtitle {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 12rpx;
}

.compare-container {
  padding: 0 32rpx;
}

.compare-slider {
  position: relative;
  height: 560rpx;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(139, 90, 43, 0.18);
}

.compare-img {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 160rpx;
}

.compare-img.before {
  width: 100%;
  background: linear-gradient(135deg, #3D3428, #5C4A3A);
  filter: grayscale(0.7) sepia(0.3);
}

.compare-img.after {
  overflow: hidden;
  background: linear-gradient(135deg, #8B6508, #C4A882);
}

.compare-divider {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #fff;
  transform: translateX(-50%);
  box-shadow: 0 0 12rpx rgba(0, 0, 0, 0.3);
  z-index: 2;
}

.compare-handle {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  z-index: 3;
}

.handle-icon {
  font-size: 36rpx;
  color: var(--primary-brown);
  line-height: 1;
}

.compare-labels {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 8rpx 0;
}

.label-item {
  font-size: 24rpx;
  color: var(--text-medium);
}

.content-section {
  padding: 48rpx 40rpx 80rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary-brown-dark);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.title-bar {
  width: 6rpx;
  height: 32rpx;
  background: var(--primary-brown);
  border-radius: 3rpx;
}

.section-text {
  font-size: 28rpx;
  color: var(--text-medium);
  line-height: 1.8;
  margin-bottom: 24rpx;
  text-align: justify;
}
