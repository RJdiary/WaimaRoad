<view class="page page--tab walk" style="{{pageStyle}}"><view class="walk__hero" style="height: 418rpx; display: flex; box-sizing: border-box"><view class="walk__sign">路牌</view><view><view class="text-calligraphy">街绘行图</view><view class="walk__sub">四条citywalk路线，边走边读外马路。</view></view><view class="walk__pin">⌖</view></view><view class="walk__overview"><text>已解锁 {{unlocked}} / {{totalRoutes}} 条路线</text><view class="walk__bar"><view class="walk__fill" style="width:{{totalRoutes ? unlocked / totalRoutes * 100 : 0}}%"></view></view></view><view wx:if="{{loading}}"><skeleton type="list"/></view><empty-state wx:elif="{{failed}}" title="路线加载失败" button-text="重新加载" bind:action="load"/><empty-state wx:elif="{{!routes.length}}" title="路线正在绘制中"/><view wx:else class="walk__list"><route-card wx:for="{{routes}}" wx:key="id" route="{{item}}" index="{{index}}" checked-count="{{checkedCounts[index]}}" bind:select="onRouteSelect" bind:start="onStart"/></view></view>
