
 .walk__hero{height:320rpx;display:flex;align-items:center;gap:20rpx;padding:0 40rpx}.walk__sign{width:160rpx;height:140rpx;background:var(--tan);border-radius:20rpx;display:flex;align-items:center;justify-content:center;transform:rotate(-4deg);color:var(--terracotta-deep)}.walk__sub{margin-top:20rpx;font-size:28rpx;color:var(--ink-2)}.walk__pin{margin-left:auto;font-size:96rpx;color:var(--coral)}.walk__overview{height:88rpx;margin:0 48rpx;padding:0 24rpx;display:flex;align-items:center;gap:20rpx;border-radius:24rpx;background:var(--apricot);font-size:24rpx}.walk__bar{flex:1;height:8rpx;border-radius:8rpx;background:var(--tan);overflow:hidden}.walk__fill{height:100%;background:var(--amber)}.walk__list{padding:40rpx 48rpx}.walk__list route-card{display:block;margin-bottom:28rpx}
