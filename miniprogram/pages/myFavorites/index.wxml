<view class="page">
  <view wx:if="{{!isEmpty}}" class="list-container">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="card"
      bindtap="goToDetail"
      data-id="{{item.id}}"
      data-category="{{item.category}}"
    >
      <view class="card-img {{item.isAiRestored ? 'ai-restored' : ''}}" style="{{item.imgStyle}}">
        {{item.emoji}}
        <view class="card-badge {{item.category}}">{{item.categoryName}}</view>
      </view>
      <view class="card-body">
        <view class="card-title serif">{{item.title}}</view>
        <view class="card-desc">{{item.summary}}</view>
        <view class="card-meta">
          <view class="meta-left">
            <text>⭐ 收藏于 {{item.favoriteTime}}</text>
          </view>
          <view class="meta-right">›</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <view class="empty-emoji">⭐</view>
    <view class="empty-title">暂无收藏内容</view>
    <view class="empty-subtitle">去发现有趣的史料吧</view>
    <button class="explore-btn" bindtap="goExplore">去探索</button>
  </view>
</view>
