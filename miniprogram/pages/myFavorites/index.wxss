.page {
  min-height: 100vh;
  background: var(--paper-bg);
}

.list-container {
  padding: 24rpx 32rpx 180rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.card {
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
}

.card-img {
  height: 280rpx;
  background: linear-gradient(135deg, #C4A882, #8B6508);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
}

.card-img.ai-restored {
  background: linear-gradient(135deg, #2D2418, #5C4A3A);
}

.card-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #fff;
}

.card-badge.building {
  background: var(--accent-gold);
}

.card-badge.red {
  background: var(--accent-red);
}

.card-badge.religion {
  background: var(--accent-green);
}

.card-badge.ai {
  background: linear-gradient(135deg, #5C4A7A, #7A5C99);
}

.card-body {
  padding: 28rpx 32rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(139, 90, 43, 0.15);
}

.meta-left {
  font-size: 22rpx;
  color: var(--text-light);
}

.meta-right {
  font-size: 32rpx;
  color: var(--text-light);
}

.empty-state {
  padding: 160rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-emoji {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-medium);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: var(--text-light);
  margin-bottom: 48rpx;
}

.explore-btn {
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 80rpx;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(139, 90, 43, 0.3);
}

.explore-btn:active {
  opacity: 0.9;
}
