<page-meta page-style="--fs:{{fontScale}}"></page-meta><view class="login"><view class="photo">埠影寻踪</view><view class="shade"></view><view class="title">欢迎<br/>请登录账号</view><view class="form {{shake ? 'shake' : ''}}"><view class="field"><text>账号</text><input data-key="account" value="{{account}}" bindinput="input" bindblur="blur" placeholder="请输入账号 / 手机号"/><view class="line {{errors.account ? 'error' : ''}}"></view><text wx:if="{{errors.account}}" class="error-text">{{errors.account}}</text></view><view class="field"><text>密码</text><input data-key="password" password="{{!visible}}" value="{{password}}" bindinput="input" bindblur="blur" placeholder="请输入密码"/><text class="eye" bindtap="toggle">{{visible ? '◉' : '◌'}}</text><view class="line {{errors.password ? 'error' : ''}}"></view><text wx:if="{{errors.password}}" class="error-text">{{errors.password}}</text></view><button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">{{loading ? '登录中…' : '登录'}}</button><view class="assist"><text bindtap="forgot">忘记密码?</text><text bindtap="goRegister">注册</text></view></view><view class="third"><view><view class="round" bindtap="wechatLogin">微</view><text>微信</text></view><view><view class="round" bindtap="qq">Q</view><text>QQ</text></view><text class="agreement">登录即代表同意《用户协议》《隐私政策》</text></view><view wx:if="{{forgot}}" class="mask"><view class="sheet"><text class="sheet-title">重置密码</text><input placeholder="手机号" value="{{resetPhone}}" data-key="resetPhone" bindinput="input"/><input placeholder="验证码（123456）" value="{{resetCode}}" data-key="resetCode" bindinput="input"/><button class="primary" bindtap="reset">确认重置</button></view></view></view>
