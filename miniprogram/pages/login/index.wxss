.login-page { position: relative; min-height: 100vh; overflow: hidden; background: #1798E7; }
.login-shade { position: absolute; inset: 0; background: radial-gradient(circle at 80% 18%, rgba(255,255,255,.22), transparent 30%), linear-gradient(180deg, #45B1E7, #167FC8); }
.login-content { position: relative; z-index: 1; padding: 322rpx 42rpx 0; color: #111; }
.login-title { font-size: 48rpx; font-weight: 700; line-height: 1.42; }
.login-form { margin-top: 118rpx; }
.field-label { color: #fff; font-size: 28rpx; margin-bottom: 10rpx; }
.password-label { margin-top: 40rpx; }
.login-input { height: 58rpx; border-bottom: 1rpx solid rgba(255,255,255,.86); color: #fff; font-size: 30rpx; }
.login-placeholder { color: rgba(255,255,255,.8); }
.login-button { margin: 100rpx 26rpx 0; height: 118rpx; line-height: 118rpx; border-radius: 68rpx; background: #238CEF; color: #fff; font-size: 34rpx; font-weight: 600; }
.login-links { display: flex; justify-content: space-between; padding: 34rpx 72rpx; color: #fff; font-size: 26rpx; }
