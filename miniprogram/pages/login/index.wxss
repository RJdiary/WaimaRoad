.login{min-height:100vh;background:var(--terracotta);color:var(--white);position:relative}.photo{position:absolute;inset:0;background:linear-gradient(145deg,#d7a982,#8a5844);font-size:56rpx;opacity:.38;padding:90rpx 48rpx}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.35),transparent 30%,rgba(0,0,0,.18))}.title{position:relative;padding:300rpx 56rpx 0;color:#111;font-size:44rpx;font-weight:700;line-height:1.5}.form{position:relative;margin:100rpx auto 0;width:600rpx}.field{position:relative;margin-bottom:48rpx}.field>text:first-child{font-size:24rpx}.field input{height:88rpx;color:#111;font-size:30rpx}.line{height:1rpx;background:rgba(255,255,255,.85)}.line.error{background:var(--danger)}.error-text{color:var(--danger);font-size:22rpx}.eye{position:absolute;right:0;bottom:22rpx;font-size:36rpx}.primary{margin-top:48rpx;width:600rpx;height:88rpx;line-height:88rpx;border-radius:44rpx;background:var(--blue);color:#fff;font-size:32rpx;font-weight:600}.assist{display:flex;justify-content:space-between;margin-top:24rpx;font-size:24rpx}.third{position:absolute;bottom:40rpx;width:100%;display:flex;justify-content:center;gap:120rpx;text-align:center;font-size:24rpx}.round{width:48rpx;height:48rpx;line-height:48rpx;margin:auto;border-radius:50%;background:var(--white);color:var(--ink)}.agreement{position:absolute;bottom:-32rpx;white-space:nowrap;font-size:20rpx}.shake{animation:shake .3s}@keyframes shake{25%{transform:translateX(-12rpx)}75%{transform:translateX(12rpx)}}.mask{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:3}.sheet{position:absolute;bottom:0;width:100%;padding:48rpx;box-sizing:border-box;border-radius:40rpx 40rpx 0 0;background:var(--bg)}.sheet input{height:88rpx;border-bottom:1rpx solid var(--line);color:var(--ink)}.sheet-title{font-size:34rpx;color:var(--ink);font-weight:600}
