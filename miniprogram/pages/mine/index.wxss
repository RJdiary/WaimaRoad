.page {
  min-height: 100vh;
  background: var(--paper-bg);
}

.my-header {
  padding: 60rpx 40rpx 80rpx;
  background: linear-gradient(160deg, #8B5A2B 0%, #6B4226 100%);
  position: relative;
  overflow: hidden;
}

.my-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.my-header::after {
  content: '';
  position: absolute;
  bottom: -120rpx;
  left: -40rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
}

.my-user-info {
  display: flex;
  align-items: center;
  gap: 32rpx;
  position: relative;
  z-index: 2;
}

.my-avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--warm-cream), var(--warm-cream-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.avatar-btn {
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-emoji {
  font-size: 64rpx;
}

.my-user-text {
  flex: 1;
}

.nickname-input {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  padding: 12rpx 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.3);
}

.nickname-placeholder {
  color: rgba(255, 255, 255, 0.5);
  font-size: 32rpx;
  font-weight: 500;
}

.login-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-top: 12rpx;
}

.name {
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
}

.signature {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.my-stats {
  margin-top: 48rpx;
  padding: 36rpx;
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 36rpx;
  position: relative;
  z-index: 2;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
}

.my-menu {
  padding: 40rpx 32rpx 180rpx;
  margin-top: -40rpx;
  background: var(--paper-bg);
  border-radius: 40rpx 40rpx 0 0;
  position: relative;
  z-index: 3;
}

.my-menu-group {
  background: #fff;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
  margin-bottom: 24rpx;
}

.my-menu-item {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.06);
}

.my-menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.menu-icon.checkin {
  background: rgba(139, 38, 53, 0.1);
  color: #8B2635;
}

.menu-icon.fav {
  background: rgba(184, 134, 11, 0.12);
  color: #B8860B;
}

.menu-icon.pref {
  background: rgba(74, 103, 65, 0.1);
  color: #4A6741;
}

.menu-icon.font {
  background: rgba(92, 74, 122, 0.1);
  color: #5C4A7A;
}

.menu-icon.privacy {
  background: rgba(139, 90, 43, 0.1);
  color: #8B5A2B;
}

.menu-icon.logout {
  background: rgba(139, 38, 53, 0.1);
  color: #8B2635;
}

.logout-item {
  justify-content: center;
}

.logout-text {
  color: var(--accent-red);
}

.menu-text {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-dark);
}

.menu-desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.menu-arrow {
  color: var(--text-light);
  font-size: 28rpx;
}

.ai-fab {
  position: fixed;
  right: 32rpx;
  bottom: 176rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 6rpx 20rpx rgba(139, 90, 43, 0.4);
  z-index: 100;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}
