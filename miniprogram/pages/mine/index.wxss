.page {
  min-height: 100vh;
  background: var(--paper-bg);
}

.my-header {
  height: 464rpx;
  margin-top: var(--miniapp-action-clearance);
  padding: 22rpx 52rpx 0;
  background: #F7E3BF;
  position: relative;
  overflow: hidden;
}

.my-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .96; }

.my-header::before {
  content: '';
  position: absolute;
  display: none;
}

.my-header::after {
  content: '';
  position: absolute;
  display: none;
}

.my-user-info {
  display: flex;
  align-items: center;
  gap: 26rpx;
  position: relative;
  z-index: 2;
}

.my-avatar {
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--warm-cream), var(--warm-cream-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  flex-shrink: 0;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.avatar-btn {
  overflow: hidden;
}

.login-entry { position: absolute; right: 44rpx; top: -46rpx; color: #fff; font-size: 24rpx; padding: 10rpx 18rpx; border: 1rpx solid rgba(255,255,255,.72); border-radius: 24rpx; }

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-emoji {
  font-size: 64rpx;
}

.my-user-text {
  flex: 1;
}

.nickname-input {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  padding: 12rpx 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.3);
}

.nickname-placeholder {
  color: rgba(255, 255, 255, 0.5);
  font-size: 32rpx;
  font-weight: 500;
}

.login-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-top: 12rpx;
}

.name {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.signature {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.my-stats {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: -86rpx;
  margin: 0;
  padding: 36rpx 24rpx;
  display: flex;
  justify-content: space-around;
  background: #FFF6E6;
  border-radius: 28rpx;
  position: relative;
  z-index: 2;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #F0A42B;
  text-align: center;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-medium);
  margin-top: 8rpx;
}

.my-menu {
  padding: 126rpx 32rpx 180rpx;
  margin-top: 0;
  background: #FFF2D7;
  border-radius: 0;
  position: relative;
  z-index: 3;
}

.my-menu-group {
  background: #FFD292;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: none;
  margin-bottom: 24rpx;
}

.my-menu-item {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 22rpx 36rpx;
  border-bottom: 1rpx solid rgba(47, 42, 40, .7);
}

.my-menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.menu-icon.checkin {
  background: rgba(139, 38, 53, 0.1);
  color: #8B2635;
}

.menu-icon.fav {
  background: rgba(184, 134, 11, 0.12);
  color: #B8860B;
}

.menu-icon.pref {
  background: rgba(74, 103, 65, 0.1);
  color: #4A6741;
}

.menu-icon.font {
  background: rgba(92, 74, 122, 0.1);
  color: #5C4A7A;
}

.menu-icon.privacy {
  background: rgba(139, 90, 43, 0.1);
  color: #8B5A2B;
}

.menu-icon.logout {
  background: rgba(139, 38, 53, 0.1);
  color: #8B2635;
}

.logout-item {
  justify-content: center;
}

.logout-text {
  color: var(--accent-red);
}

.menu-text {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-dark);
}

.menu-desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.menu-arrow {
  color: var(--text-light);
  font-size: 28rpx;
}

.ai-fab {
  position: fixed;
  right: 32rpx;
  bottom: 176rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 6rpx 20rpx rgba(139, 90, 43, 0.4);
  z-index: 100;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}
