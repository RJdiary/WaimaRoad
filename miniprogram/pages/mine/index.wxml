<view class="page">
  <view class="my-header">
    <view class="my-user-info">
      <block wx:if="{{!userInfo}}">
        <button class="my-avatar avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <text wx:if="{{!tempAvatarUrl}}" class="avatar-emoji">👤</text>
          <image wx:else src="{{tempAvatarUrl}}" class="avatar-img" mode="aspectFill"></image>
        </button>
        <view class="my-user-text">
          <input
            class="nickname-input"
            type="nickname"
            placeholder="点击输入昵称"
            placeholder-class="nickname-placeholder"
            value="{{tempNickname}}"
            bindinput="onNicknameInput"
            bindblur="onNicknameBlur"
          />
          <view class="login-tip">填写头像和昵称后自动登录</view>
        </view>
      </block>
      <block wx:else>
        <image class="my-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view class="my-user-text">
          <view class="name serif">{{userInfo.nickName}}</view>
          <view class="signature">探索城市历史文化的脚步</view>
        </view>
      </block>
    </view>

    <view class="my-stats">
      <view class="stat-item">
        <view class="stat-num serif">{{stats.checkins}}</view>
        <view class="stat-label">打卡数</view>
      </view>
      <view class="stat-item">
        <view class="stat-num serif">{{stats.favorites}}</view>
        <view class="stat-label">收藏数</view>
      </view>
      <view class="stat-item">
        <view class="stat-num serif">{{stats.routes}}</view>
        <view class="stat-label">足迹数</view>
      </view>
    </view>
  </view>

  <view class="my-menu">
    <view class="my-menu-group">
      <view class="my-menu-item" bindtap="goToMyCheckins">
        <view class="menu-icon checkin">📍</view>
        <view class="menu-text">
          <view class="menu-title">我的打卡点</view>
          <view class="menu-desc">查看所有已打卡的历史点位</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="my-menu-item" bindtap="goToMyFavorites">
        <view class="menu-icon fav">⭐</view>
        <view class="menu-text">
          <view class="menu-title">我的收藏</view>
          <view class="menu-desc">管理收藏的史料与点位</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>

    <view class="my-menu-group">
      <view class="my-menu-item" bindtap="goToPreferenceSettings">
        <view class="menu-icon pref">💖</view>
        <view class="menu-text">
          <view class="menu-title">喜好设置</view>
          <view class="menu-desc">设置感兴趣的史料分类</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="my-menu-item" bindtap="goToFontSettings">
        <view class="menu-icon font">🔤</view>
        <view class="menu-text">
          <view class="menu-title">字体设置</view>
          <view class="menu-desc">调节阅读字体大小</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="my-menu-item" bindtap="goToPrivacySettings">
        <view class="menu-icon privacy">🔒</view>
        <view class="menu-text">
          <view class="menu-title">隐私设置</view>
          <view class="menu-desc">个人资料与授权管理</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>

    <view wx:if="{{userInfo}}" class="my-menu-group">
      <view class="my-menu-item logout-item" bindtap="onLogout">
        <view class="menu-icon logout">🚪</view>
        <view class="menu-text">
          <view class="menu-title logout-text">退出登录</view>
          <view class="menu-desc">清除当前账号的登录状态</view>
        </view>
      </view>
    </view>
  </view>

  <ai-chat></ai-chat>
</view>
