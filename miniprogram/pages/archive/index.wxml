<view class="page page--tab archive" style="{{pageStyle}};padding-top:{{statusBarHeight}}px"><view class="archive__header"><view class="archive__title text-calligraphy">埠藏史库</view><view class="archive__subtitle">外马路·现存与消失的人文空间</view><view class="archive__book"><view></view><text>⌁</text></view></view><view class="archive__filters"><filter-chips options="{{filters}}" selected="{{category}}" bind:change="onFilterChange" /><view class="archive__search" bindtap="onSearch"><view></view></view></view><view class="archive__list"><skeleton wx:if="{{loading && list.length === 0}}" type="list" count="3" /><empty-state wx:elif="{{!loading && !error && list.length === 0}}" title="这个分类还没有史料" desc="换个分类，或看看全部" action-text="看看全部" bind:action="onShowAll" /><view wx:elif="{{error && list.length === 0}}" class="archive__error"><text>加载失败，请稍后重试</text><button class="archive__retry tap" bindtap="onRetry">重试</button></view><block wx:else><site-card wx:for="{{list}}" wx:key="id" site="{{item}}" variant="terracotta" bind:select="onCardSelect" /><view wx:if="{{error}}" class="archive__bottom"><text>加载失败，请稍后重试</text><text bindtap="onRetry">重试</text></view><view wx:elif="{{loading}}" class="archive__bottom">正在加载更多…</view><view wx:elif="{{!hasMore}}" class="archive__bottom">已经到底啦</view></block></view></view>
