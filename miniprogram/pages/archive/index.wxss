
.archive__header { position:relative; height:300rpx; }.archive__title { position:absolute; top:96rpx; left:48rpx; font-size:calc(64rpx * var(--fs)); letter-spacing:4rpx; }.archive__subtitle { position:absolute; top:186rpx; left:48rpx; color:#555555; font-size:calc(28rpx * var(--fs)); }.archive__book { position:absolute; top:64rpx; right:40rpx; width:200rpx; height:180rpx; color:#6B4A3A; opacity:.85; }.archive__book view { position:absolute; top:54rpx; left:20rpx; width:132rpx; height:82rpx; border:4rpx solid #6B4A3A; border-radius:8rpx 20rpx 20rpx 8rpx; transform:rotate(-9deg); }.archive__book text { position:absolute; right:16rpx; top:16rpx; font-size:100rpx; transform:rotate(35deg); }.archive__filters { position:relative; padding-right:104rpx; }.archive__search { position:absolute; top:8rpx; right:24rpx; display:flex; width:72rpx; height:72rpx; align-items:center; justify-content:center; border:1rpx solid var(--amber); border-radius:50%; }.archive__search view { position:relative; width:25rpx; height:25rpx; border:4rpx solid var(--amber); border-radius:50%; }.archive__search view::after { content:''; position:absolute; right:-11rpx; bottom:-6rpx; width:14rpx; height:4rpx; transform:rotate(45deg); background:var(--amber); }.archive__list { padding:32rpx 48rpx calc(160rpx + env(safe-area-inset-bottom)); }.archive__list site-card { display:block; margin-bottom:32rpx; }.archive__error { display:flex; min-height:300rpx; flex-direction:column; align-items:center; justify-content:center; color:var(--ink-2); font-size:calc(24rpx * var(--fs)); }.archive__retry { width:220rpx; height:88rpx; margin-top:24rpx; border-radius:44rpx; background:var(--terracotta-deep); color:var(--white); font-size:calc(28rpx * var(--fs)); line-height:88rpx; }.archive__bottom { display:flex; min-height:88rpx; align-items:center; justify-content:center; gap:24rpx; color:var(--ink-3); font-size:calc(24rpx * var(--fs)); }
