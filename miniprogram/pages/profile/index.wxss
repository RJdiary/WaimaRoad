.profile{min-height:100vh;background:var(--bg)}.cover{height:560rpx;background:linear-gradient(135deg,#d6b68e,#b4755a);position:relative;color:#fff}.identity{position:absolute;z-index:2;left:48rpx;bottom:88rpx;display:flex;align-items:center;gap:20rpx;font-size:40rpx;font-weight:700}.identity text{display:block;font-size:26rpx;font-weight:400}.avatar{width:128rpx;height:128rpx;line-height:128rpx;text-align:center;border:4rpx solid #fff;border-radius:50%;background:var(--chip)}.content{position:relative;z-index:1;margin-top:-48rpx;border-radius:48rpx 48rpx 0 0;padding:112rpx 48rpx 48rpx;background:var(--bg)}.stats{height:176rpx;background:var(--white);border-radius:24rpx;display:flex}.stats view{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;font-size:24rpx}.stats .stat-number{font-size:56rpx;color:var(--amber)}.menu{margin-top:32rpx;background:var(--apricot);border-radius:24rpx;overflow:hidden}.menu view{height:112rpx;line-height:112rpx;padding:0 32rpx;border-bottom:1rpx solid rgba(0,0,0,.08);font-size:30rpx}.menu text{float:right}
