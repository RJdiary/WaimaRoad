<view class="page">
  <view class="preview-card">
    <view class="preview-title">预览效果</view>
    <view class="preview-text" style="font-size: {{currentFontSize}}rpx;">
      济南老火车站由德国建筑师赫尔曼·菲舍尔设计，始建于1904年，1912年建成投入使用。这座建筑是典型的德国青年风格派作品，被誉为"亚洲最漂亮的火车站"之一。车站主体为圆柱形钟楼，顶部为绿色穹顶，塔钟镶嵌在四面墙体上，方圆百里清晰可见。
    </view>
  </view>

  <view class="section-title serif">选择字号</view>

  <view class="font-options">
    <view
      class="font-option {{currentSize === item.key ? 'active' : ''}}"
      wx:for="{{fontSizeOptions}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="selectSize"
    >
      <view class="font-option-size serif" style="font-size: {{item.size}}rpx;">Aa</view>
      <view class="font-option-label">{{item.label}}</view>
    </view>
  </view>

  <view class="switch-card">
    <view class="switch-left">
      <view class="switch-icon">💾</view>
      <view class="switch-text">
        <view class="switch-title">自动同步系统字体</view>
        <view class="switch-desc">跟随系统字体大小变化</view>
      </view>
    </view>
    <switch
      checked="{{autoSync}}"
      color="#8B5A2B"
      bindchange="onAutoSyncChange"
    />
  </view>
</view>
