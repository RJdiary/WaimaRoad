.page {
  min-height: 100vh;
  background: var(--paper-bg);
  padding-bottom: 40rpx;
}

.preview-card {
  margin: 32rpx;
  padding: 40rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
}

.preview-title {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 20rpx;
}

.preview-text {
  line-height: 1.8;
  color: var(--text-dark);
  transition: font-size 0.25s ease;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary-brown-dark);
  padding: 20rpx 32rpx 16rpx;
}

.font-options {
  padding: 0 32rpx;
  display: flex;
  justify-content: space-around;
  gap: 16rpx;
}

.font-option {
  flex: 1;
  margin: 0 8rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border-radius: 24rpx;
  background: #fff;
  transition: all 0.25s ease;
}

.font-option.active {
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(139, 90, 43, 0.3);
}

.font-option-size {
  font-weight: 600;
}

.font-option-label {
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 8rpx;
}

.switch-card {
  margin: 32rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.switch-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(139, 90, 43, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.switch-text {
  flex: 1;
}

.switch-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-dark);
}

.switch-desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}
