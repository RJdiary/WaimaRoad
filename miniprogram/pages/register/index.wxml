<page-meta page-style="--fs:{{fontScale}}"></page-meta><view class="register"><view class="back" bindtap="back">‹</view><text class="head">创建账号</text><view class="card"><view wx:for="{{['nickname','phone','code','password','confirm']}}" wx:key="*this" class="field"><text>{{['昵称','手机号','验证码','密码','确认密码'][index]}}</text><input data-key="{{item}}" bindinput="input" password="{{index>2}}"/><text wx:if="{{item==='code'}}" class="code" bindtap="getCode">{{countdown?countdown+'s':'获取验证码'}}</text></view><view class="agree" bindtap="toggleAgree"><text class="check {{agreed?'on':''}}">✓</text>我已阅读并同意《用户协议》《隐私政策》</view><button class="primary {{agreed?'':'disabled'}}" bindtap="submit">注册并登录</button></view></view>
