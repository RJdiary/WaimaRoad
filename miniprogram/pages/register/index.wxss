.register{min-height:100vh;background:linear-gradient(rgba(0,0,0,.35),rgba(0,0,0,.35)),var(--terracotta);padding:88rpx 48rpx;box-sizing:border-box}.back{display:inline-flex;width:88rpx;height:88rpx;align-items:center;color:#fff;font-size:56rpx}.head{margin-left:24rpx;color:#fff;font-size:36rpx;font-weight:600}.card{margin-top:64rpx;padding:40rpx;background:#fff;border-radius:32rpx}.field{position:relative;padding:18rpx 0;border-bottom:1rpx solid var(--line);color:var(--ink);font-size:24rpx}.field input{height:60rpx;font-size:30rpx}.code{position:absolute;right:0;bottom:20rpx;color:var(--blue)}.agree{margin:32rpx 0;color:var(--ink-2);font-size:24rpx}.check{display:inline-block;width:28rpx;height:28rpx;text-align:center;line-height:28rpx;border:1rpx solid var(--line);margin-right:12rpx}.check.on{background:var(--terracotta);color:#fff}.primary{width:100%;height:88rpx;line-height:88rpx;border-radius:44rpx;background:var(--blue);color:#fff}.disabled{opacity:.5}
