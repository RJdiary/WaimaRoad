page {
  /* 统一的「旧纸张」底色。页面可直接复用这些变量，不必各自维护色值。 */
  --primary-brown: #CC795B;
  --primary-brown-light: #F3B985;
  --primary-brown-dark: #A8523B;
  --warm-cream: #FDE6BB;
  --warm-cream-dark: #F5D5A2;
  --paper-bg: #FFF9ED;
  --text-dark: #2F2A28;
  --text-medium: #5A5552;
  --text-light: #8D8580;
  --accent-red: #E85D51;
  --accent-gold: #F4A632;
  --accent-green: #70CFA7;
  /* 自定义导航页的内容从微信右上角功能胶囊下方开始，避免首屏元素被遮挡。 */
  --miniapp-action-clearance: calc(env(safe-area-inset-top) + 96rpx);

  background-color: var(--paper-bg);
  background-image:
    radial-gradient(circle at 12% 8%, rgba(184, 134, 11, 0.07), transparent 28%),
    radial-gradient(circle at 88% 22%, rgba(139, 38, 53, 0.04), transparent 25%),
    linear-gradient(135deg, rgba(255,255,255,0.42), rgba(245,230,211,0.26));
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--text-dark);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.serif {
  font-family: "Noto Serif SC", "Songti SC", "SimSun", serif;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

.btn-primary {
  background: var(--primary-brown);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 40rpx;
  border: none;
}

.btn-primary:active {
  background: var(--primary-brown-dark);
}

.btn-secondary {
  background: var(--warm-cream);
  color: var(--primary-brown);
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 40rpx;
  border: none;
}

.btn-secondary:active {
  background: var(--warm-cream-dark);
}

.btn-outline {
  background: transparent;
  color: var(--primary-brown);
  border: 2rpx solid var(--primary-brown);
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 40rpx;
}

.btn-outline:active {
  background: var(--warm-cream);
}
