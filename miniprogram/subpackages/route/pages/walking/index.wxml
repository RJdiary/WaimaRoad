<map style="width:100%;height:100vh" latitude="{{latitude}}" longitude="{{longitude}}" show-location scale="16" polyline="{{polyline}}" markers="{{markers}}"><cover-view wx:if="{{loading}}" class="walk-top">路线加载中…</cover-view><cover-view wx:elif="{{failed}}" class="walk-top">路线加载失败，请返回重试</cover-view><cover-view wx:else class="walk-top">{{current ? current.name : '正在定位'}}　剩余 {{distance}}m　{{checked}}/{{route.stops.length}}</cover-view><cover-view wx:if="{{route && !loading && !failed}}" class="walk-card" style="bottom:184rpx">{{current ? current.name : '正在加载目标点'}}</cover-view><cover-view wx:if="{{route && !loading && !failed}}" class="walk-card" style="bottom:96rpx;text-align:center" bindtap="checkin">{{distance <= 200 ? '到此打卡' : '距离点位 ' + distance + 'm'}}</cover-view><cover-view wx:if="{{route && !loading && !failed}}" class="walk-card" style="bottom:24rpx;text-align:center;padding:12rpx" bindtap="confirmFinish">结束走街</cover-view></map><view wx:if="{{done}}" class="done"><view>走街完成 {{route.name}}</view><canvas id="poster" type="2d" style="width:600rpx;height:800rpx"/><button bindtap="finish">返回走街页</button></view>
