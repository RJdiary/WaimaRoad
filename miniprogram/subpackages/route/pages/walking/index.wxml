<map wx:if="{{route}}" style="width:100vw;height:100vh" latitude="{{latitude}}" longitude="{{longitude}}" show-location scale="16" polyline="{{polyline}}" markers="{{markers}}"><cover-view class="walk-top">{{current ? current.name : '正在定位'}}　剩余 {{distance}}m　{{checked}}/{{route.stops.length}}</cover-view><cover-view class="walk-card"><cover-view>{{current ? current.name : '正在加载目标点'}}</cover-view><cover-view bindtap="checkin">{{distance <= 200 ? '到此打卡' : '距离点位 ' + distance + 'm'}}</cover-view><cover-view bindtap="finish">结束走街</cover-view></cover-view></map><view wx:if="{{done}}" class="done"><view>走街完成 {{route.name}}</view><canvas id="poster" type="2d" style="width:600rpx;height:800rpx"/><button bindtap="finish">返回走街页</button></view>
