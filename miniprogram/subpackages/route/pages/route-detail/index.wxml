<view class="page"><map wx:if="{{route}}" style="width:100%;height:620rpx" polyline="{{polyline}}" markers="{{markers}}" include-points="{{route.polyline}}"><cover-view class="map-back" bindtap="start">‹</cover-view><cover-view class="map-info">路线信息</cover-view></map><view wx:if="{{route}}" class="route-detail"><view class="t-page-title">{{route.name}}</view><view>{{route.distance}}km · {{route.duration}}分钟 · {{route.stops.length}}个点位 · {{checked}} 已打卡</view><view>{{route.intro}}</view><button bindtap="start">{{checked === route.stops.length ? '查看走街记录' : '开始走街'}}</button></view></view>
