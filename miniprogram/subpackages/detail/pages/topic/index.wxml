<view class="page topic"><nav-bar title="专题" show-back/><view class="topic__hero"><view class="t-page-title">{{filtered[0].categoryName}}</view><text>{{filtered.length}} 个点位</text></view><filter-chips options="{{years}}" selected="{{year}}" bind:change="onYear"/><filter-chips options="{{statuses}}" selected="{{status}}" bind:change="onStatus"/><empty-state wx:if="{{!filtered.length}}" title="这个专题还没有史料"/><view wx:else class="topic__list"><site-card wx:for="{{filtered}}" wx:key="id" site="{{item}}" bind:select="select"/></view><view class="topic__entry"><button bindtap="walk">Citywalk路线</button><button bindtap="ai">AI复原影像</button></view></view>
