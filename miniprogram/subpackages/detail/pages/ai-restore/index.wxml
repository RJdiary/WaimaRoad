<view class="page restore"><nav-bar title="AI 复原影像" show-back/><view class="restore__notice">用 AI 补全已消失的天际线，复原仅供想象，不作为史料依据。</view><empty-state wx:if="{{!sites.length}}" title="暂无可复原点位"/><view wx:for="{{sites}}" wx:key="id" class="restore__card" data-id="{{item.id}}" bindtap="detail"><view class="restore__images"><view class="media-placeholder">旧照</view><view class="media-placeholder">复原</view><text>AI 生成</text></view><view class="t-card-title">{{item.name}}</view><view class="t-aux">{{item.era}} · {{item.summary}}</view></view><view wx:if="{{sites.length}}" class="restore__pick"><view>生成我的复原</view><view wx:for="{{sites}}" wx:key="id" data-site="{{item}}" bindtap="pick">{{item.name}}</view></view><view wx:if="{{progress}}" class="restore__progress">正在生成 {{progress}}%</view><view wx:if="{{result}}"><compare-slider today-src="{{selected.oldPhotos[0].url}}" old-src="{{resultPath}}"/><text>AI 生成 / 仅供想象</text><button bindtap="save">保存</button><button open-type="share">分享</button></view><canvas id="restore-canvas" type="2d" class="restore__canvas" style="width:600rpx;height:800rpx"/></view>
