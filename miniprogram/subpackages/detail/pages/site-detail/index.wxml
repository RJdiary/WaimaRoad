<view class="page detail"><nav-bar title="史料详情" show-back/><view wx:if="{{loading}}"><skeleton type="detail"/></view><empty-state wx:elif="{{failed}}" title="史料加载失败" button-text="重新加载" bind:action="load"/><block wx:else><swiper class="detail__swiper" bindchange="onSlide"><swiper-item wx:for="{{site.images}}" wx:key="*this"><image wx:if="{{item}}" src="{{item}}" mode="aspectFill"/><view wx:else class="media-placeholder">{{site.name}}</view></swiper-item></swiper><view class="detail__count">{{imageIndex}}/{{site.images.length}}</view><view class="detail__body"><view class="t-page-title">{{site.name}}</view><view class="detail__tags"><text>{{site.categoryName}}</text><text>{{site.era}}</text><text>{{site.currentStatus}}</text></view><view class="detail__meta" bindtap="navigate">{{site.address}}　›</view><view class="detail__meta">{{site.openTime}} <text wx:if="{{distance}}">· 距你 {{distance}}</text></view><view class="detail__intro">{{site.description}}</view><view class="detail__archive">建筑小档案　建造年代 {{site.era}}　结构 {{site.structure}}　原用途 {{site.originalUse}}　现状 {{site.currentStatus}}</view><view wx:if="{{site.oldPhotos.length}}" class="detail__section"><view class="t-card-title">今昔对照</view><view class="detail__hint">拖动分割线，看同一机位的一百年</view><compare-slider today-src="{{site.images[0] || site.cover}}" old-src="{{aiRestored ? site.aiRestored : site.oldPhotos[0].url}}"/><button class="detail__restore" bindtap="restore">{{aiProgress ? '复原中 ' + aiProgress + '%' : 'AI 复原'}}</button><view wx:if="{{aiRestored}}" class="detail__watermark">{{aiNotice}}</view></view><view class="detail__check"><view>距点位 {{distance || '—'}} · 可打卡范围 200m</view><button disabled="{{!canCheckin}}" bindtap="checkin">{{checkinText}}</button></view><view class="detail__section"><view class="t-card-title">相关推荐</view><view class="detail__related"><view wx:for="{{related}}" wx:key="id" class="detail__related-card"><view class="media-placeholder">{{item.name}}</view><text>{{item.name}}</text></view></view></view></view><view class="detail__bottom"><button bindtap="favorite">{{favorited ? '★ 已收藏' : '☆ 收藏'}}</button><button class="detail__primary" bindtap="checkin">打卡</button><button open-type="share">分享</button></view></block><checkin-sheet visible="{{sheetVisible}}" site-name="{{site.name}}" count="{{sheetCount}}" time="{{sheetTime}}" bind:close="closeSheet"/></view>
