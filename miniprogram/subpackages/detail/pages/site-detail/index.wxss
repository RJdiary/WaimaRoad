

.detail{padding-bottom:112rpx}.detail__swiper{height:560rpx}.detail__swiper image,.detail__swiper .media-placeholder{width:100%;height:100%}.detail__count{position:absolute;right:40rpx;top:520rpx;padding:4rpx 16rpx;border-radius:32rpx;background:var(--white);font-size:22rpx}.detail__body{position:relative;margin-top:-48rpx;padding:48rpx;border-radius:48rpx 48rpx 0 0;background:var(--bg)}.detail__tags text{display:inline-block;margin:16rpx 12rpx 0 0;padding:4rpx 12rpx;background:var(--apricot);border-radius:8rpx;font-size:22rpx}.detail__meta,.detail__hint{margin-top:16rpx;color:var(--ink-2);font-size:24rpx}.detail__intro{margin-top:24rpx;text-indent:2em;font-size:28rpx;line-height:1.8}.detail__archive,.detail__check{margin-top:32rpx;padding:24rpx;border-radius:24rpx;background:var(--apricot);font-size:24rpx;line-height:1.8}.detail__section{position:relative;margin-top:40rpx}.detail__restore,.detail__check button{margin-top:16rpx;border-radius:44rpx;background:var(--blue);color:var(--white);font-size:24rpx}.detail__watermark{position:absolute;right:16rpx;bottom:96rpx;color:var(--white);font-size:22rpx}.detail__related{display:flex;gap:16rpx;overflow:auto}.detail__related-card{width:240rpx;flex:none;font-size:24rpx}.detail__related-card .media-placeholder{height:180rpx;border-radius:16rpx}.detail__bottom{position:fixed;z-index:8;left:0;right:0;bottom:0;padding:12rpx 32rpx;background:var(--white);display:flex;gap:16rpx;box-shadow:var(--shadow-float)}.detail__bottom button{flex:1;background:var(--apricot);font-size:24rpx}.detail__bottom .detail__primary{background:var(--blue);color:var(--white);border-radius:44rpx}
