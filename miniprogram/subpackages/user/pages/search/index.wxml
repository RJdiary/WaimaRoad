<page-meta page-style="--fs:{{fontScale}}"></page-meta><view class="search"><text class="back" bindtap="back">‹</text><input value="{{keyword}}" bindinput="input" placeholder="搜建筑、路线、关键词"/><text bindtap="search">搜索</text></view><view class="page"><view wx:if="{{!keyword}}"><view class="history-head"><text class="card-title">搜索历史</text><text bindtap="clearHistory">清空</text></view><text wx:for="{{history}}" wx:key="*this" data-key="{{item}}" bindtap="onKeywordTap">{{item}}</text><text class="card-title">热门搜索</text><text wx:for="{{hotKeywords}}" wx:key="*this" data-key="{{item}}" bindtap="onKeywordTap">{{item}}</text></view><view wx:for="{{list}}" wx:key="id" class="card"><text class="card-title">{{item.name}}</text><text>{{item.summary}}</text></view><empty-state wx:if="{{keyword&&!list.length}}" title="没有找到相关内容"/></view>
