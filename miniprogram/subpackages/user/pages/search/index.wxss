.search{display:flex;align-items:center;gap:16rpx;padding:60rpx 24rpx 16rpx;background:var(--bg)}.back{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;font-size:52rpx;line-height:1}.search input{height:72rpx;flex:1;padding:0 24rpx;border-radius:36rpx;background:var(--white);font-size:26rpx}.search-action{display:flex;align-items:center;justify-content:center;min-width:88rpx;min-height:88rpx;color:var(--blue);font-size:26rpx}.page{min-height:100vh;padding:32rpx 48rpx 96rpx;background:var(--bg);color:var(--ink)}.history-head{display:flex;align-items:center;justify-content:space-between}.card-title,.group-title{font-size:30rpx;font-weight:600}.clear{display:flex;align-items:center;justify-content:center;min-width:88rpx;min-height:72rpx;color:var(--ink-2);font-size:24rpx}.chips{display:flex;flex-wrap:wrap;gap:16rpx;margin:16rpx 0 32rpx}.chips text{padding:12rpx 20rpx;background:var(--apricot);border-radius:32rpx;font-size:24rpx}.hot-title{display:block;margin-top:32rpx}.group{margin-bottom:40rpx}.group-title{display:block;margin-bottom:16rpx}.result-card{padding:24rpx 0;border-bottom:1rpx solid var(--line)}.result-title,.result-summary{display:block}.result-title{font-size:28rpx;font-weight:600}.result-summary{margin-top:8rpx;color:var(--ink-2);font-size:24rpx;line-height:1.5}.highlight{padding:0 2rpx;background:var(--tag);color:var(--ink);font-weight:600}.loading{padding:64rpx 0;text-align:center;color:var(--ink-2);font-size:26rpx}
