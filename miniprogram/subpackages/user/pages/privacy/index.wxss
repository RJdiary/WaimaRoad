.page{min-height:100vh;padding:160rpx 48rpx;background:var(--bg);box-sizing:border-box}.card{min-height:88rpx;padding:24rpx;margin-bottom:16rpx;border-radius:24rpx;background:var(--white);color:var(--ink)}.danger{color:var(--danger)}.delete-mask{position:fixed;z-index:9;inset:0;background:rgba(0,0,0,.45)}.delete-sheet{position:absolute;bottom:0;width:100%;box-sizing:border-box;padding:48rpx;background:var(--bg);border-radius:40rpx 40rpx 0 0;color:var(--ink)}.delete-title{display:block;font-size:34rpx;font-weight:600}.delete-sheet input{height:88rpx;margin:32rpx 0;padding:0 24rpx;border-radius:16rpx;background:var(--white)}.delete-actions{display:flex;gap:24rpx}.delete-actions button{flex:1}.delete-confirm{background:var(--danger);color:var(--white)}
