.page{min-height:100vh;padding:160rpx 48rpx;background:var(--bg);box-sizing:border-box;color:var(--ink)}.card{padding:32rpx;border-radius:24rpx;background:var(--apricot);display:flex;flex-direction:column;gap:18rpx}.preview b{font-size:calc(34rpx * var(--fs))}.preview text{font-size:calc(28rpx * var(--fs))}.segments{display:flex;margin-top:32rpx}.segments button{flex:1;font-size:24rpx}
