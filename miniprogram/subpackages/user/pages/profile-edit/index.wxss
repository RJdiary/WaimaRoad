.page{min-height:100vh;padding:160rpx 48rpx 96rpx;background:var(--bg);box-sizing:border-box;color:var(--ink)}.avatar-area{display:flex;flex-direction:column;align-items:center;margin-bottom:40rpx}.avatar{width:128rpx;height:128rpx;padding:0;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:50%;background:var(--apricot);color:var(--ink-2);font-size:22rpx}.avatar image{width:128rpx;height:128rpx}.avatar-fallback{display:flex;align-items:center;justify-content:center;min-height:72rpx;margin-top:12rpx;color:var(--blue);font-size:24rpx}.field{margin-top:32rpx}.label{display:block;margin-bottom:12rpx;font-size:26rpx;font-weight:600}.field input,.field textarea{display:block;width:100%;padding:24rpx;box-sizing:border-box;background:var(--white);border:1rpx solid var(--line);border-radius:16rpx;font-size:28rpx}.hint{display:block;min-height:36rpx;margin-top:8rpx;text-align:right;color:var(--ink-3);font-size:22rpx}.hint-error{color:var(--danger)}.save-next{width:100%;height:88rpx;margin-top:48rpx;border-radius:44rpx;background:var(--blue);color:var(--white);font-size:30rpx}
