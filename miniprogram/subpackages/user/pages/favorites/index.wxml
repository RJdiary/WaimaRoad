<page-meta page-style="--fs:{{fontScale}}"></page-meta>
<nav-bar show-back title="我的收藏" bind:back="back"/>
<view class="page"><view class="tabs"><text wx:for="{{tabs}}" wx:key="0" data-key="{{item[0]}}" bindtap="changeTab" class="{{tab===item[0]?'active':''}}">{{item[1]}}</text></view><skeleton wx:if="{{loading}}" type="list"/><view wx:for="{{displayList}}" wx:key="id" class="card"><view data-item="{{item}}" bindtap="open"><text class="card-title">{{item.type==='site'?'史料收藏':'路线收藏'}}</text><text>{{item.targetId}}</text></view><text class="cancel" data-item="{{item}}" bindtap="remove">取消收藏</text></view><empty-state wx:if="{{!loading&&!displayList.length}}" title="收藏夹还是空的" action-text="去逛史料" bind:action="archive"/></view>
