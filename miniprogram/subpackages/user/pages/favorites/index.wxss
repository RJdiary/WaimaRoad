.page{min-height:100vh;padding:160rpx 48rpx;background:var(--bg);box-sizing:border-box}.tabs{display:flex;margin-bottom:24rpx;border-bottom:1rpx solid var(--line)}.tabs text{flex:1;height:72rpx;line-height:72rpx;text-align:center;color:var(--ink-3)}.tabs .active{color:var(--ink);font-weight:600;border-bottom:4rpx solid var(--terracotta)}.card{padding:32rpx;margin-bottom:24rpx;border-radius:24rpx;background:var(--apricot);color:var(--ink)}.card text{display:block;color:var(--ink-2)}.card .card-title{color:var(--ink);font-size:30rpx}.cancel{display:block;margin-top:20rpx;color:var(--terracotta-deep);font-size:24rpx}
