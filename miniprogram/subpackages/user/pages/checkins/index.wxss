.view-switch{display:inline-flex;align-items:center;justify-content:center;min-width:88rpx;min-height:88rpx;color:var(--blue);font-size:24rpx}.page{min-height:100vh;padding:160rpx 48rpx 80rpx;background:var(--bg);box-sizing:border-box}.card{display:flex;flex-direction:column;gap:12rpx;padding:28rpx;margin-bottom:24rpx;border-radius:24rpx;background:var(--white);box-shadow:var(--shadow-card);color:var(--ink)}.card text{color:var(--ink-2);font-size:24rpx}.card-title{color:var(--ink)!important;font-size:30rpx!important;font-weight:600}.checkin-map{width:100%;height:860rpx;border:4rpx solid var(--tan);border-radius:24rpx;overflow:hidden}.status-card{display:flex;flex-direction:column;align-items:center;gap:24rpx;padding:64rpx 32rpx;border-radius:24rpx;background:var(--apricot);color:var(--ink-2)}.status-card button{min-width:176rpx;border-radius:44rpx;background:var(--blue);color:var(--white);font-size:26rpx}
