<page-meta page-style="--fs:{{fontScale}}"></page-meta>
<nav-bar show-back title="喜好设置" bind:back="back"><text slot="right" bindtap="save">保存</text></nav-bar>
<view class="page"><view class="card"><text class="card-title">感兴趣的主题</text><view class="grid"><view wx:for="{{themeCards}}" wx:key="key" data-key="{{item.key}}" bindtap="toggleTheme" class="theme {{item.selected?'selected':''}}">{{item.name}}<text wx:if="{{item.selected}}">✓</text></view></view></view><view class="card">推荐偏好 <slider min="1" max="5" step="1" value="{{recommendBias}}" bindchange="bias" activeColor="#D98C75"/></view><view class="card">打卡提醒 <switch data-key="checkin" checked="{{notify.checkin}}" bindchange="toggleNotify"/></view><view class="card">路线推荐 <switch data-key="route" checked="{{notify.route}}" bindchange="toggleNotify"/></view><view class="card">系统公告 <switch data-key="system" checked="{{notify.system}}" bindchange="toggleNotify"/></view><view class="card">显示已消失点位 <switch checked="{{showLost}}" bindchange="toggleLost"/></view><view class="card">默认地图图层 <text data-key="sites" bindtap="layer" class="{{mapLayer==='sites'?'selected':''}}">史料点</text>　<text data-key="routes" bindtap="layer" class="{{mapLayer==='routes'?'selected':''}}">路线</text></view></view>
