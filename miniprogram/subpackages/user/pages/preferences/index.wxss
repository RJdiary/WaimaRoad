.page{min-height:100vh;padding:160rpx 48rpx;background:var(--bg);box-sizing:border-box}.card{padding:32rpx;margin-bottom:24rpx;border-radius:24rpx;background:var(--white);color:var(--ink)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:24rpx;margin-top:24rpx}.theme{position:relative;padding:40rpx 16rpx;background:var(--apricot);border:4rpx solid transparent}.theme.selected{border-color:var(--terracotta)}.theme text{position:absolute;right:12rpx;top:12rpx;color:var(--terracotta-deep)}.selected{color:var(--terracotta-deep);font-weight:600}
