<view wx:if="{{visible}}" class="poi fade-up"><image wx:if="{{poi.cover}}" class="poi__cover" src="{{poi.cover}}" mode="aspectFill" lazy-load/><view wx:else class="poi__cover media-placeholder">{{poi.name}}</view><view class="poi__main"><view class="poi__name ellipsis">{{poi.name}}</view><text class="poi__tag">{{poi.categoryName}}</text><text class="poi__distance">{{poi.distanceText || '定位后显示距离'}}</text><view class="poi__actions"><text bindtap="detail">详情</text><text bindtap="checkin">打卡</text><text bindtap="favorite">{{favorited ? '已收藏' : '收藏'}}</text></view></view><view class="poi__close tap" bindtap="close" aria-label="关闭点位卡">×</view></view>
