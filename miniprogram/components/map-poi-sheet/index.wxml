<view wx:if="{{visible}}" class="poi"><view wx:if="{{poi.cover}}"><image class="poi__cover" src="{{poi.cover}}" mode="aspectFill"/></view><view wx:else class="poi__cover media-placeholder">{{poi.name}}</view><view class="poi__main"><view class="poi__close tap" bindtap="close">×</view><view class="poi__name ellipsis">{{poi.name}}</view><view class="poi__tag">{{poi.categoryName}}</view><view class="poi__distance">距你 {{poi.distance || '—'}}</view><view class="poi__actions"><text bindtap="detail">详情</text><text bindtap="checkin">打卡</text><text bindtap="favorite">{{favorited ? '已收藏' : '收藏'}}</text></view></view></view>
