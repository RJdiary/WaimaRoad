.poi{width:606rpx;min-height:196rpx;padding:24rpx;background:var(--white);border-radius:var(--radius-card);display:flex;box-shadow:var(--shadow-float)}.poi__cover{width:160rpx;height:160rpx;border-radius:16rpx;flex:none}.poi__main{position:relative;flex:1;padding-left:20rpx}.poi__name{padding-right:40rpx;font-size:32rpx;font-weight:600}.poi__tag,.poi__distance{margin-top:8rpx;font-size:22rpx;color:var(--ink-2)}.poi__actions{display:flex;justify-content:space-between;margin-top:16rpx;color:var(--blue);font-size:24rpx}.poi__close{position:absolute;right:0;top:-10rpx;font-size:36rpx}
