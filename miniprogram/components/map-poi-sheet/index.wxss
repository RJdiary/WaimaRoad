.poi{position:fixed;z-index:20;bottom:calc(112rpx + env(safe-area-inset-bottom) + 24rpx);left:40rpx;display:flex;width:670rpx;height:260rpx;overflow:hidden;border-radius:24rpx;background:var(--white);box-shadow:var(--shadow-float)}.poi__cover{width:160rpx;height:100%;flex:none;text-align:center}.poi__main{min-width:0;flex:1;padding:18rpx 20rpx}.poi__name{padding-right:72rpx;font-size:32rpx;font-weight:600}.poi__tag{display:inline-block;margin-top:8rpx;padding:3rpx 12rpx;border-radius:8rpx;background:var(--tag);color:var(--ink);font-size:22rpx}.poi__distance{display:block;margin-top:4rpx;color:var(--ink-2);font-size:22rpx}.poi__actions{display:flex;height:88rpx;align-items:flex-end;justify-content:space-between;color:var(--terracotta-deep);font-size:24rpx}.poi__actions text{min-width:88rpx;text-align:center}.poi__close{position:absolute;right:0;top:0;display:flex;width:88rpx;height:88rpx;align-items:center;justify-content:center;font-size:36rpx}
