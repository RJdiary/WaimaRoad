<view wx:if="{{visible}}" class="sheet" catchtap="close"><view class="sheet__card" catchtap=""><view wx:for="{{12}}" wx:key="*this" class="sheet__confetti"></view><view class="sheet__close tap" bindtap="close">×</view><view class="sheet__title">你已点亮 {{siteName}}</view><view class="sheet__sub">累计打卡 {{count}} 次</view><view class="sheet__stamp">{{stampText}}</view><view class="sheet__time">{{time}}</view><button class="sheet__button" bindtap="share">分享这份足迹</button></view></view>
