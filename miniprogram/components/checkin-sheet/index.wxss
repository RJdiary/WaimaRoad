.sheet{position:fixed;z-index:99;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;animation:fade .2s}.sheet__card{position:relative;width:536rpx;padding:64rpx 32rpx;background:var(--bg);border-radius:32rpx;text-align:center;overflow:hidden;animation:rise .24s cubic-bezier(.2,.8,.2,1)}.sheet__close{position:absolute;right:20rpx;top:16rpx;font-size:40rpx}.sheet__title{font-size:34rpx;font-weight:600}.sheet__sub,.sheet__time{margin-top:16rpx;font-size:24rpx;color:var(--ink-2)}.sheet__stamp{margin:32rpx auto;width:140rpx;height:140rpx;border:4rpx solid var(--terracotta-deep);border-radius:50%;color:var(--terracotta-deep);font-size:28rpx;line-height:140rpx;transform:rotate(-10deg)}.sheet__button{margin-top:32rpx;border-radius:44rpx;background:var(--blue);color:var(--white);font-size:28rpx}.sheet__confetti{position:absolute;width:10rpx;height:28rpx;background:var(--amber);left:calc((var(--i,1))*8%);top:0}.sheet__confetti:nth-child(2n){background:var(--coral)}@keyframes fade{from{opacity:0}to{opacity:1}}@keyframes rise{from{transform:translateY(24rpx)}to{transform:translateY(0)}}
