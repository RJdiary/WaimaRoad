<view class="site-card site-card--{{variant}} tap-scale" bindtap="onSelect" hover-class="none"><image wx:if="{{site.cover}}" class="site-card__cover" src="{{site.cover}}" mode="aspectFill" lazy-load /><view wx:else class="site-card__cover media-placeholder">{{site.name}}</view><view class="site-card__tag">{{site.categoryName}}</view><view wx:if="{{showFavorite}}" class="site-card__favorite tap" catchtap="onFavorite">{{favorited ? '★' : '☆'}}</view><view class="site-card__body"><view class="site-card__name ellipsis">{{site.name}}</view><view class="site-card__summary ellipsis-2">{{site.summary}}</view><view class="site-card__line"></view></view><view class="site-card__footer"><view class="site-card__stats"><text>◉ {{viewText}}</text><text>☆ {{favoriteText}}</text></view><text class="site-card__arrow">›</text></view></view>
