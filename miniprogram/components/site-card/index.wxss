.site-card { position: relative; overflow: hidden; border-radius: var(--radius-card); box-shadow: var(--shadow-site); } .site-card--terracotta { background: var(--terracotta); color: #2A2A2A; } .site-card--plain { background: var(--apricot); color: var(--ink); } .site-card__cover { display: flex; width: 100%; height: 390rpx; align-items: center; justify-content: center; } .site-card__tag { position: absolute; top: 20rpx; left: 20rpx; padding: 6rpx 16rpx; border-radius: 8rpx; background: var(--tag); color: #4A2B1E; font-size: calc(22rpx * var(--fs)); } .site-card__favorite { position: absolute; top: 12rpx; right: 12rpx; display: flex; align-items: center; justify-content: center; color: var(--white); font-size: 36rpx; } .site-card__body { padding: 28rpx 28rpx 0; } .site-card__name { font-size: calc(34rpx * var(--fs)); line-height: 1.4; font-weight: 600; } .site-card__summary { min-height: 79rpx; margin-top: 8rpx; color: #4A3A33; font-size: calc(24rpx * var(--fs)); line-height: 1.65; } .site-card--plain .site-card__summary, .site-card--plain .site-card__footer { color: var(--ink-2); } .site-card__line { height: 1rpx; margin-top: 24rpx; background: rgba(255,255,255,.35); } .site-card--plain .site-card__line { background: var(--line); } .site-card__footer { display: flex; height: 96rpx; padding: 0 28rpx; align-items: center; justify-content: space-between; color: #3B2B25; font-size: calc(24rpx * var(--fs)); } .site-card__stats { display: flex; gap: 40rpx; } .site-card__arrow { font-size: 32rpx; }
