.route{position:relative;padding:32rpx;border-radius:var(--radius-card);background:var(--apricot);box-shadow:var(--shadow-card);overflow:hidden}.route__top{display:flex;align-items:center;gap:16rpx}.route__index{font-family:"DIN Alternate",sans-serif;font-size:56rpx;font-weight:700;color:var(--amber)}.route__tag{padding:4rpx 16rpx;border-radius:var(--radius-chip);font-size:22rpx;background:var(--tan);color:var(--terracotta)}.route__name{font-size:34rpx;font-weight:600}.route__meta,.route__intro{margin-top:8rpx;font-size:24rpx;color:var(--ink-2)}.route__progress{margin-top:24rpx;display:flex;align-items:center;gap:16rpx;font-size:22rpx;color:var(--ink-2)}.route__bar{flex:1;height:8rpx;border-radius:8rpx;background:rgba(0,0,0,.08);overflow:hidden}.route__fill{height:100%;background:var(--terracotta)}.route__start{margin-top:16rpx;text-align:right;color:var(--terracotta);font-size:28rpx}.route--qiaoxiang .route__fill{background:var(--amber)}.route--qiaoxiang .route__start{color:var(--amber)}.route--wenjiao .route__fill{background:var(--teal)}.route--wenjiao .route__start{color:var(--teal)}.route--hongse .route__fill{background:var(--terracotta-deep)}.route--hongse .route__start{color:var(--terracotta-deep)}
