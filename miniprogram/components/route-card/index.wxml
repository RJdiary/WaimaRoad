<view class="route tap-scale route--{{route.theme}}" bindtap="select"><view class="route__top"><text class="route__index">{{displayIndex}}</text><text class="route__tag">{{route.themeName}}</text></view><view class="route__name">{{route.name}}</view><view class="route__meta">{{route.distance}}km · {{route.duration}}分钟 · {{total}}个点位</view><view class="route__intro ellipsis">{{route.intro}}</view><view class="route__progress"><view class="route__bar"><view class="route__fill" style="width:{{progress}}%"></view></view><text>{{checkedCount}}/{{total}} 已打卡</text></view><view class="route__start tap" catchtap="start">开始走街 →</view></view>
