.chips { background: var(--bg); } .chips--sticky { position: sticky; top: 0; z-index: 10; } .chips__scroll { white-space: nowrap; } .chips__row { display: inline-flex; padding: 0 48rpx; } .chips__hit { padding: 12rpx 0; margin-right: 20rpx; min-height: 88rpx; box-sizing: border-box; } .chips__item { height: 64rpx; padding: 0 32rpx; border-radius: 32rpx; background: var(--chip); color: #222222; font-size: calc(26rpx * var(--fs)); line-height: 64rpx; opacity: .95; } .chips__item--active { background: #333333; color: var(--white); }
