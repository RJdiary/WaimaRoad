.skeleton__card { width: 654rpx; margin: 0 auto 24rpx; padding: 24rpx; box-sizing: border-box; border-radius: var(--radius-card); background: var(--bg-warm); }
.skeleton__cover, .skeleton__line, .skeleton__bottom { animation: breathe 1.2s ease-in-out infinite; background: var(--tan); }
.skeleton__cover { width: 100%; height: 390rpx; border-radius: var(--radius-card); }
.skeleton__line { height: 24rpx; margin-top: 20rpx; border-radius: var(--radius-sm); }
.skeleton__line--title { width: 60%; }.skeleton__line--long { width: 90%; }.skeleton__line--short { width: 70%; }
.skeleton__bottom { width: 96rpx; height: 24rpx; margin-top: 24rpx; border-radius: var(--radius-sm); }
