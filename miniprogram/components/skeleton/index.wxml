<view class="skeleton">
  <block wx:if="{{type === 'list'}}"><view wx:for="{{[0, 1, 2]}}" wx:key="*this" class="skeleton__card"><view class="skeleton__cover"></view><view class="skeleton__line skeleton__line--title"></view><view class="skeleton__line skeleton__line--long"></view><view class="skeleton__line skeleton__line--short"></view><view class="skeleton__bottom"></view></view></block>
  <view wx:elif="{{type === 'detail'}}" class="skeleton__card"><view class="skeleton__cover"></view><view class="skeleton__line skeleton__line--title"></view><view class="skeleton__line skeleton__line--long"></view><view class="skeleton__line skeleton__line--short"></view></view>
  <view wx:else class="skeleton__card"><view class="skeleton__cover"></view><view class="skeleton__line skeleton__line--title"></view><view class="skeleton__line skeleton__line--long"></view><view class="skeleton__line skeleton__line--short"></view><view class="skeleton__bottom"></view></view>
</view>
