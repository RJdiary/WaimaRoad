.ai-chat-wrapper {
  position: relative;
}

.ai-fab-btn {
  position: fixed;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(139, 90, 43, 0.4);
  z-index: 999;
}

.fab-icon {
  color: #fff;
  font-size: 48rpx;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

.ai-chat-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.ai-chat-panel {
  width: 100%;
  height: 75vh;
  background: var(--paper-bg);
  border-radius: 56rpx 56rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.35s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.ai-chat-header {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.1);
}

.ai-chat-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ai-chat-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.ai-chat-title-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ai-chat-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.ai-chat-status {
  font-size: 22rpx;
  color: var(--accent-green);
}

.ai-chat-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(139, 90, 43, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-medium);
}

.ai-quick-questions {
  padding: 20rpx 24rpx;
  display: flex;
  gap: 16rpx;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.08);
  white-space: nowrap;
}

.quick-q {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(139, 90, 43, 0.08);
  font-size: 24rpx;
  color: var(--primary-brown);
  white-space: nowrap;
  display: inline-block;
}

.ai-messages {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  overflow-y: auto;
}

.msg {
  display: flex;
  gap: 16rpx;
  max-width: 85%;
}

.msg.ai {
  align-self: flex-start;
}

.msg.user {
  align-self: flex-end;
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.msg-avatar.ai {
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
}

.msg-avatar.user {
  background: linear-gradient(135deg, #A8C4A0, #6B8B5A);
}

.msg-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.msg-bubble {
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  max-width: 100%;
  word-break: break-all;
}

.msg-bubble.ai {
  background: #fff;
  color: var(--text-dark);
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 90, 43, 0.12);
}

.msg-bubble.user {
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  color: #fff;
  border-top-right-radius: 8rpx;
}

.msg-feedback {
  display: flex;
  gap: 12rpx;
  padding-left: 8rpx;
}

.feedback-btn {
  font-size: 20rpx;
  color: var(--text-light);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.ai-input-area {
  padding: 20rpx 24rpx 40rpx;
  border-top: 1rpx solid rgba(139, 90, 43, 0.1);
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.ai-input {
  flex: 1;
  padding: 20rpx 28rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.2);
  background: #fff;
  font-size: 28rpx;
  color: var(--text-dark);
  max-height: 160rpx;
  line-height: 1.5;
}

.ai-input-placeholder {
  color: var(--text-light);
}

.ai-send-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-brown), var(--primary-brown-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 90, 43, 0.3);
  flex-shrink: 0;
}
