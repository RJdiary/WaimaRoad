<view class="compare" style="height:{{height}}" bindtouchstart="onStart" bindtouchmove="onMove" bindtouchend="onEnd" aria-role="slider"><view class="compare__base media-placeholder"></view><image wx:if="{{todaySrc}}" class="compare__image" src="{{todaySrc}}" mode="aspectFill"/><view class="compare__clip" style="width:{{percentValue}}%"><view class="compare__old media-placeholder"></view><image wx:if="{{oldSrc}}" class="compare__image" src="{{oldSrc}}" mode="aspectFill"/></view><view class="compare__label compare__label--old">{{oldLabel}}</view><view class="compare__label compare__label--today">{{todayLabel}}</view><view class="compare__line" style="left:{{percentValue}}%"><view class="compare__handle">↔</view></view><view class="compare__nudge compare__nudge--left" data-step="-5" bindtap="nudge"></view><view class="compare__nudge compare__nudge--right" data-step="5" bindtap="nudge"></view></view>
